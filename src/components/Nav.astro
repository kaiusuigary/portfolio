---
import { useT, switchPath } from "../i18n.js";

const { lang = "ja" } = Astro.props;
const t = useT(lang);
---

<div
  style="position:sticky;top:18px;z-index:30;display:flex;justify-content:center;padding:0 20px;"
>
  <div
    class="glass nav-bar"
    style="width:100%;max-width:1400px;border-radius:999px;padding:10px 12px 10px 26px;box-shadow:0 14px 30px -10px rgba(16,27,52,.22);"
  >
    <a href="#home" style="display:flex;align-items:baseline;gap:8px;color:var(--ink);">
      <span class="disp" style="font-weight:800;font-size:18px;letter-spacing:.02em;">KAI USUI</span>
      <span style="font-size:12.5px;color:var(--ink-faint);">Portfolio</span>
    </a>

    <a href={switchPath(Astro.url.pathname)} class="lang-switch lang-switch--mobile" hreflang={t("en", "ja")} lang={t("en", "ja")}>{t("EN", "JP")}</a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
    <label for="nav-toggle" class="nav-toggle-btn" aria-label={t("メニューを開く", "Open menu")}>
      <span></span><span></span><span></span>
    </label>

    <div class="nav-links">
      <a href="#about" style="color:var(--ink-soft);">About</a>
      <a href="#works" style="color:var(--ink-soft);">Works</a>
      <a href="#other" style="color:var(--ink-soft);">Other Projects</a>
      <a href={switchPath(Astro.url.pathname)} class="lang-switch" hreflang={t("en", "ja")} lang={t("en", "ja")}>{t("EN", "JP")}</a>
      <a href="#contact" class="btn" style="padding:11px 22px;font-size:13px;">Contact Me</a>
    </div>
  </div>
</div>

<script>
  // スマホのメニューでリンクを押したらメニューを閉じる
  const toggle = document.getElementById("nav-toggle") as HTMLInputElement | null;
  document.querySelectorAll(".nav-links a").forEach((a) => {
    a.addEventListener("click", () => {
      if (toggle) toggle.checked = false;
    });
  });
</script>
