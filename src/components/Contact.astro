---
---

<section id="contact" class="section" style="padding-bottom:40px;">
  <div class="wrap" style="position:relative;">
    <img
      src="/images/contact-card.png"
      alt="Call me maybe"
      class="contact-float-card"
      style="position:absolute;top:-56px;right:6%;width:clamp(160px,18vw,260px);transform:rotate(8deg);z-index:3;filter:drop-shadow(0 30px 40px rgba(16,27,52,.28));"
    />
    <div class="glass contact-panel">
      <div
        class="ghost"
        style="position:absolute;bottom:-0.28em;left:50%;transform:translateX(-50%);font-size:clamp(64px,11vw,120px);opacity:.8;white-space:nowrap;"
      >
        CONTACT ME
      </div>
      <div style="position:relative;">
        <div class="eyebrow" style="justify-content:center;">How to find me</div>
        <h2 class="disp" style="font-size:clamp(30px,4.4vw,50px);font-weight:800;color:var(--ink);max-width:640px;margin:0 auto;">
          お気軽にご連絡ください。
        </h2>
        <p style="font-size:15.5px;line-height:1.9;color:var(--ink-soft);max-width:520px;margin:20px auto 0 auto;">
          これまでの制作実績を詳しくご紹介いたします。ご連絡は下記のメール、またはLinkedInアカウントまでお願いいたします。ありがとうございます。
        </p>
        <div style="display:flex;gap:16px;justify-content:center;margin-top:40px;flex-wrap:wrap;">
          <a href="mailto:kaijo.gary@gmail.com" class="btn">kaijo.gary@gmail.com</a>
          <a href="https://www.linkedin.com/in/kai-jo-0a8791289/" class="btn-ghost">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap" style="max-width:1400px;">
    <div
      class="glass"
      style="display:flex;justify-content:space-between;align-items:center;margin-top:40px;flex-wrap:wrap;gap:12px;border-radius:999px;padding:22px 40px;box-shadow:0 14px 30px -10px rgba(16,27,52,.22);"
    >
      <div class="disp" style="font-weight:800;font-size:15px;color:var(--ink);">KAI USUI</div>
      <div style="font-size:12.5px;color:var(--ink-faint);">© Kai Usui — UI/UX Designer</div>
    </div>
  </div>
</section>
