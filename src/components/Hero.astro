---
---

<section id="home" class="section">
  <div
    class="ghost hero-hello"
    style="position:absolute;top:-36px;left:50%;transform:translateX(-50%);font-size:clamp(120px,19vw,300px);z-index:1;"
  >
    HELLO
  </div>

  <div class="sticker" style="top:150px;left:2%;transform:rotate(-9deg);">UI / UX</div>
  <div class="sticker" style="top:64px;right:4%;transform:rotate(7deg);">APP DESIGN</div>

  <div class="wrap hero-grid" style="margin-top:112px;max-width:1400px;">
    <div>
      <h1 class="disp hero-title" style="font-size:clamp(38px,6.4vw,84px);font-weight:800;color:var(--ink);margin-top:56px;">
        Nice to meet you.
      </h1>
      <p class="disp" style="margin:16px 0 0 0;font-size:clamp(16px,2.6vw,19px);font-weight:600;color:var(--ink-soft);">
        UI / UX Designer — 4カ国語を操るマルチリンガル、14年のキャリア
      </p>
      <div style="display:flex;gap:16px;margin-top:26px;flex-wrap:wrap;">
        <a href="#contact" class="btn">
          Contact Me
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path
              d="M12 5v14M6 13l6 6 6-6"
              stroke="#ffffff"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
        <a href="#works" class="btn-outline">
          <span class="btn-outline-fill">
            <span class="btn-outline-text">Works を見る</span>
          </span>
        </a>
      </div>
      <div class="stat-row">
        <div style="padding:18px 24px;border-radius:20px;display:flex;align-items:center;gap:14px;">
          <div class="disp" style="font-size:clamp(38px,5vw,60px);font-weight:800;color:var(--ink);line-height:1;">4</div>
          <div style="font-size:11.5px;font-weight:700;letter-spacing:.08em;color:var(--ink-faint);line-height:1.5;">
            LANGUAGES<br />QUADRILINGUAL
          </div>
        </div>
        <div style="padding:18px 24px;border-radius:20px;display:flex;align-items:center;gap:14px;">
          <div class="disp" style="font-size:clamp(38px,5vw,60px);font-weight:800;color:var(--ink);line-height:1;">14</div>
          <div style="font-size:11.5px;font-weight:700;letter-spacing:.08em;color:var(--ink-faint);line-height:1.5;">
            YEARS<br />EXPERIENCE
          </div>
        </div>
      </div>
      <div class="sticker sticker-multilingual" style="top:560px;left:2%;transform:rotate(6deg);">MULTILINGUAL</div>
    </div>

    <div class="hero-visual">
      <div style="position:absolute;top:-18px;left:-18px;width:calc(100% + 36px);height:calc(100% + 36px);background:radial-gradient(ellipse, rgba(76,141,255,.26), transparent 68%);filter:blur(60px);"></div>
      <div style="position:absolute;bottom:-18px;right:-18px;width:calc(100% + 36px);height:calc(100% + 36px);background:radial-gradient(ellipse, rgba(51,214,199,.20), transparent 68%);filter:blur(60px);"></div>
      <img
        src="/images/hero-card.png"
        style="position:relative;width:100%;max-width:520px;border-radius:32px;display:block;transform:rotate(-5deg);"
        alt="YES Pay app mockup"
      />
      <div class="sticker" style="bottom:-14px;right:-16px;transform:rotate(-6deg);">14 YEARS EXP.</div>
    </div>
  </div>
</section>
