<script>
  // 横のツールタグは各 CASE の位置＋data-offset に置く（DETAILS の開閉で CASE の位置が変わるため）
  const section = document.getElementById("works");
  const place = () => {
    if (!section) return;
    const base = section.getBoundingClientRect().top;
    section.querySelectorAll<HTMLElement>(".works-sticker").forEach((el) => {
      const c = document.getElementById(el.dataset.case || "");
      if (c) el.style.top = `${c.getBoundingClientRect().top - base + Number(el.dataset.offset || 0)}px`;
    });
  };
  place();
  window.addEventListener("load", place);
  window.addEventListener("resize", place);
  document.querySelectorAll<HTMLDetailsElement>("#works .case-more").forEach((d) => {
    d.addEventListener("toggle", () => {
      place();
      // 閉じたときに CASE が画面より上に行ってしまったら、その CASE の頭まで戻す
      const c = d.closest(".case-anchor");
      if (!d.open && c && c.getBoundingClientRect().top < 0) c.scrollIntoView();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("#works .case-more-close").forEach((b) => {
    b.addEventListener("click", () => {
      const d = b.closest("details");
      if (d) d.open = false;
    });
  });
  // 分類一覧などから #case-0x で来たときも位置を合わせる
  window.addEventListener("hashchange", place);

  // プロトタイプ動画は見えているときだけ再生。録画の最後に Figma の操作バーが映るので data-end で頭に戻す
  document.querySelectorAll<HTMLVideoElement>("#works .lg-video video").forEach((v) => {
    const end = Number(v.dataset.end) || Infinity;
    v.addEventListener("timeupdate", () => {
      if (v.currentTime >= end) v.currentTime = 0;
    });
    v.addEventListener("ended", () => {
      v.currentTime = 0;
      v.play();
    });
    new IntersectionObserver(([e]) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause()), { threshold: 0.3 }).observe(v);
