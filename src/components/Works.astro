---
import { useT } from "../i18n.js";
import CategoryTabs from "./CategoryTabs.astro";

const { lang = "ja" } = Astro.props;
const t = useT(lang);

// CASE 02 全体リニューアル: BEFORE/AFTER pairs, search filter rows, key changes
const pairs = [
  {
    before: "/images/lg-before-map.webp",
    after: "/images/lg-after-map.webp",
    label: t("マップ", "Map"),
    note: t("ヘッダーとナビは、アプリ全体の世界観と一体感のある半透明のテクスチャに。ナビは「ホーム・探す・充電・知る・マイページ」に組み直し、「充電」を中央の赤いボタンとして独立させました。", "The header and tab bar use a translucent texture that ties in with the look and feel of the whole app. The tab bar was rebuilt as Home / Search / Charge / Learn / My Page, with “Charge” pulled out as a red button in the center."),
  },
  {
    before: "/images/lg-before-charge.webp",
    after: "/images/lg-after-charge.webp",
    label: t("チャージ", "Top-up"),
    note: t("金額を大きく左揃えで見せ、現在の残高とチャージできる範囲をそのすぐ近くに表示しました。ボタンにも「10,000円をチャージする」と金額を入れ、押す前に内容を確かめられるようにしています。", "The amount is shown large and left-aligned, with the current balance and the allowed top-up range right next to it. The button also states the amount (“Top up ¥10,000”), so users can check what they are about to do before tapping."),
  },
  {
    before: "/images/lg-before-wallet.webp",
    after: "/images/lg-after-wallet.webp",
    label: t("クレジットカード（登録済み）", "Saved credit card"),
    full: true,
    note: t("登録済みのカードを、入力フォームのような見た目から実物のカードに近いビジュアルに変更し、どのカードが登録されているかひと目でわかるようにしました。番号と有効期限は一覧で読みやすく整理し、「変更する」「削除する」の操作もひとまとめにして見つけやすくしています。", "The saved card used to look like a form; now it is shown as a card-like visual, so users can tell at a glance which card is registered. The number and expiry date are laid out as an easy-to-read list, and the change and delete actions are grouped together so they are easy to find."),
  },
];

// Search filter section 53962:101722: top row = before the full redesign, bottom row = after
const sfScreens = [
  { id: "off", label: t("検索フィルタ（初期状態）", "Search filter (default)") },
  { id: "on", label: t("検索フィルタ（選択あり）", "Search filter (with selections)") },
  { id: "card", label: t("充電カード・アプリ", "Charging cards / apps") },
  { id: "facility", label: t("施設の種類", "Facility types") },
];

// 主な変更点：冒頭のコンセプト3つ（方針）ごとに具体策をまとめる
const pointGroups = [
  {
    name: "Inspired",
    lead: t("充電をもっと身近に、スマートな移動体験を", "Make charging feel closer and smarter"),
    items: [
      [t("iOS・Android共通のガラス表現", "A glass style for iOS and Android"), t("長く止まっていたUIの更新を体験全体の見直しとして行い、変化がひと目で伝わるよう、ガラスのような半透明の素材をデザインシステムに取り入れました。iOSのLiquid Glassを参考にしつつ、Androidでも同じ見た目と使い心地になるよう、OSに依存しない共通の表現として設計。近年のOSの見た目となじむため、OSとアプリを行き来しても違和感がなく、画面の切り替わりもスムーズに感じられます。ヘッダーや主要ボタンに使い、EVにふさわしい先進的でプレミアムな印象を目指しました。", "UI updates had stalled, so this was a full review of the experience. To make the change obvious at a glance, I added a translucent, glass-like material to the design system. It takes cues from iOS’s Liquid Glass but was designed as a shared style that looks and feels the same on Android. Because it matches the look of recent operating systems, moving between the OS and the app feels seamless and screen transitions feel smooth. Used on headers and key buttons, it gives the premium, forward-looking feel an EV brand needs.")],
      [t("ライトモードとダークモード", "Light and dark mode"), t("昼の屋外でも夜の車内でも、使う環境に合わせてストレスなく使えるよう、すべての画面をライト／ダークの両方で設計。白すぎない背景（bgPrimary）を基本にして、長い時間見ても目が疲れにくくしました。", "So the app is comfortable to use in any setting — outdoors by day or in the car at night — every screen was designed in both light and dark. The base background is a soft off-white (bgPrimary) rather than pure white, to be easier on the eyes.")],
    ],
  },
  {
    name: "Reliable",
    lead: t("誰でも、どんな状況でも、迷わず確実に使える", "Anyone, anywhere, without hesitation"),
    items: [
      [t("「充電」を主役のボタンに", "Charge as the primary action"), t("充電開始はアプリでいちばん大切な行動。ナビのほかの項目から独立させ、ブランドカラーの赤で目立たせ、片手でも押しやすい位置に置きました。", "Starting a charge is the app’s most important action, so it is separated from the other tabs, highlighted in the brand red and placed where a thumb reaches it easily.")],
      [t("ダイナミックアイランドと充電画面", "Dynamic Island and charging screens"), t("ロック画面とダイナミックアイランドで充電の経過時間を見られるようにし、アプリ内の充電画面も同じイラストとアニメーションでそろえ、「ちゃんと充電できている」ことが伝わるようにしました。", "Elapsed charging time now shows on the Lock Screen and Dynamic Island, and the in-app charging screens share the same illustration and animation, so users can see that charging is really working.")],
    ],
  },
  {
    name: "Universal",
    lead: t("年齢や環境に関わらず、すべてのドライバーへ", "For every driver, whatever their age or situation"),
    items: [
      [t("フォントの選定", "Choosing the typeface"), t("RobotoからInterに変更しました。屋外の日差しの下や暗い駐車場でも、「90kW」「85%」「25分」のような数字と単位をすぐ読めるように。1・I・lの区別がはっきりしていて、マップ上の小さな文字（10〜12px）もつぶれません。", "I switched from Roboto to Inter, so numbers and units like “90kW”, “85%” and “25 min” read instantly in sunlight or a dark car park. Inter clearly separates 1, I and l, and small map labels (10–12px) stay crisp.")],
      [t("コントラストと色の見直し", "Contrast and color"), t("文字と背景のコントラスト比を高めるよう色を調整し、ライト／ダークの両モードで対になる色を定義しました。色覚の多様性にも配慮し、色だけに頼らずに状態を示します。", "Colors were adjusted for higher text contrast and defined as light/dark pairs. States never rely on color alone, so they also work for people with color vision differences.")],
      [t("左揃えを最優先に", "Left alignment first"), t("iOS・Androidどちらでも自然に読めるよう、見出し・本文・ダイアログを左揃えに統一しました。視線の動きに沿うため、「どこから読むか」で迷わず、内容をすばやく拾えます。", "Headings, body text and dialogs are left-aligned so they read naturally on both iOS and Android. It follows how the eye moves, so users never wonder where to start and can scan content quickly.")],
      [t("入力済みと未入力を色で分ける", "Filled vs. empty fields"), t("「選択してください」などの未入力の表示と、ユーザーが入力した内容の色をはっきり分け、入力漏れに気づきやすくしました。", "Placeholder text like “Please select” and user-entered values use clearly different colors, so missing fields are easy to spot.")],
    ],
  },
];

---

<section id="works" class="section">
  <div
    class="ghost"
    style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(70px,11vw,170px);z-index:0;opacity:.7;"
  >
    WORKS
  </div>

  <!-- CASE 01 tool tags -->
  <div class="sticker works-sticker" data-case="case-01" data-offset="-32" style="top:280px;right:2%;transform:rotate(-6deg);">FIGMA</div>
  <div class="sticker works-sticker" data-case="case-01" data-offset="88" style="top:400px;left:3.5%;transform:rotate(5deg);">ILLUSTRATOR</div>
  <div class="sticker works-sticker" data-case="case-01" data-offset="208" style="top:520px;right:1%;transform:rotate(7deg);">PHOTOSHOP</div>

  <!-- CASE 02 tool tags -->
  <div class="sticker works-sticker" data-case="case-02" data-offset="-32" style="top:1003px;right:2%;transform:rotate(-6deg);">FIGMA</div>

  <!-- CASE 03 tool tags -->
  <div class="sticker works-sticker" data-case="case-03" data-offset="-34" style="top:1643px;right:2%;transform:rotate(-6deg);">ILLUSTRATOR</div>
  <div class="sticker works-sticker" data-case="case-03" data-offset="86" style="top:1763px;left:3.5%;transform:rotate(5deg);">PHOTOSHOP</div>
  <div class="sticker works-sticker" data-case="case-03" data-offset="206" style="top:1883px;right:1%;transform:rotate(7deg);">FIGMA</div>

  <div class="wrap">
    <div class="works-head">
      <div>
        <div class="eyebrow">My Works</div>
        <h2 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">{t("代表的な制作実績", "Selected Works")}</h2>
      </div>
      <CategoryTabs lang={lang} />
    </div>

    <!-- ============ CASE 01 ============ -->
    <div id="case-01" class="case-anchor" style="margin-top:80px;">
      <div class="case-media-grid">
        <a
          href="/images/app-full3.jpg"
          target="_blank"
          rel="noopener"
          class="shot-panel lightbox-trigger"
          style="display:flex;align-items:center;justify-content:center;"
        >
          <img src="/images/app-top3.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("EV充電エネチェンジ アプリ", "EV Charge ENECHANGE app")} />
          <span class="expand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <div>
          <div class="case-num">CASE 01</div>
          <h3 class="disp case-title-lg">{t("EV充電エネチェンジ アプリ改修 — v4.0「ニコラ」メジャーアップデート", "EV Charge ENECHANGE App Redesign — v4.0 “Nikola” Major Update")}</h3>
          <hr class="divider" style="margin:24px 0;max-width:120px;" />
          <div class="meta-label">{t("期間", "Duration")}</div>
          <p class="meta-value">{t("約2ヶ月", "About 2 months")}</p>
          <div class="meta-label">{t("チーム構成", "Team")}</div>
          <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("プロジェクトマネージャー1", "1 project manager")}<br />{t("ディレクター1", "1 director")}<br />{t("エンジニア3", "3 engineers")}</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
            <a href="https://apps.apple.com/jp/app/id911721775" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">App Store ↗</a>
            <a href="https://play.google.com/store/apps/details?id=net.evsmart" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">Google Play ↗</a>
            <a href="https://ev-plus.jp/miraene-note/ev-charge-enechange-app-update-nikola/" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">{t("開発チームのインタビュー記事 ↗", "Interview with the dev team (JP) ↗")}</a>
            <a href="https://ev-charge-enechange.jp/for_drivers/ev-life-program/" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">EV Life Program LP ↗</a>
          </div>
        </div>
      </div>

      <details class="case-more">
        <summary class="case-more-btn"><span class="when-closed">{t("詳しく見る", "View details")}</span><span class="when-open">{t("閉じる", "Close")}</span></summary>
      <div class="ghost-mid">DETAILS</div>

      <div class="grid-3 detail-grid">
        <div>
          <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
          <p class="detail-text">{t("充電スポット検索アプリ「EV充電エネチェンジ」のメジャーアップデート（v4.0「ニコラ」、2026年4月リリース）。充電スポットの検索が中心だったアプリを、ポイントやプリペイド残高、最新ニュースにすぐアクセスできる「EVの総合ポータル」へと進化させる改修が求められました。", "A major update to “EV Charge ENECHANGE”, an app for finding EV charging spots (v4.0 “Nikola”, released April 2026). The goal was to evolve an app built mainly around searching for charging spots into an “all-in-one EV portal” where users can instantly access their points, prepaid balance and the latest news.")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
          <ul class="detail-list">
            <li>{t("使いやすいUIによるマイページの利便性向上", "Make My Page more convenient with an easy-to-use UI")}</li>
            <li>{t("EVライフプログラムへの参加促進", "Encourage sign-ups for the EV Life Program")}</li>
            <li>{t("アプリへの愛着（ロイヤルティ）を高め、充電利用と事業成長につなげる", "Build loyalty to the app, driving charging usage and business growth")}</li>
          </ul>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
          <ul class="detail-list">
            <li>{t("v4.0アップデートのUI/UXデザイン", "UI/UX design for the v4.0 update")}</li>
            <li>{t("ホーム画面（新設）のデザイン", "Design of the new Home screen")}</li>
            <li>{t("マイページのデザイン", "Design of My Page")}</li>
            <li>{t("EVライフプログラムLPのデザイン", "Design of the EV Life Program LP")}</li>
          </ul>
        </div>
        <div>
          <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
          <p class="detail-text"><b style="color:var(--ink);">{t("1. 「EVの総合ポータル」としてのホーム画面", "1. A Home screen that works as an “all-in-one EV portal”")}</b><br />{t("検索が中心だったアプリにホーム画面を新設。ポイントやプリペイド残高、最新ニュースなど、ユーザーが今知りたい情報にすぐアクセスできる構成にしました。", "I added a new Home screen to an app that had been centered on search, structured so users can instantly reach what they want to know right now — points, prepaid balance, the latest news and more.")}</p>
          <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. 特別感と直感性を両立したプログラム画面", "2. Program screens that feel special yet intuitive")}</b><br />{t("新しく始まる「EVライフプログラム」は、ユーザーにとって誇らしく特別なものになるよう、高級感のある洗練されたシンプルなデザインに。アイコンや色でステージの違いが直感的にわかるよう、情報設計にもこだわりました。", "To make the new “EV Life Program” something users feel proud of and special about, I gave it a premium, refined and simple design. I also paid close attention to the information architecture so that icons and colors make the different stages instantly clear.")}</p>
          <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("3. 迷わず使えるマイページ", "3. A My Page that’s easy to navigate")}</b><br />{t("プリペイド残高や登録カードを上部にまとめ、その下にクーポン・充電履歴などのサービス、表示・通知などの設定、ヘルプをグループごとに整理。項目が多くても目的の機能を見つけやすい構成にしました。", "Prepaid balance and registered cards sit together at the top, with services such as coupons and charging history, settings such as display and notifications, and help organized into groups below. Even with many items, users can easily find the feature they need.")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
          <ul class="detail-list">
            <li>{t("高級感・洗練", "Premium & refined")}</li>
            <li>{t("直感的にわかる", "Intuitive")}</li>
            <li>{t("使うたびに楽しい", "Fun every time you use it")}</li>
          </ul>
        </div>
        <div>
          <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
          <div class="swatch-row">
            <div class="swatch"><span style="background:#C60D31;"></span>#C60D31</div>
            <div class="swatch"><span style="background:#7D1631;"></span>#7D1631</div>
            <div class="swatch"><span style="background:#52B9C2;"></span>#52B9C2</div>
            <div class="swatch"><span style="background:#333333;"></span>#333333</div>
            <div class="swatch"><span style="background:#FFFFFF;border:1px solid var(--border);"></span>#FFFFFF</div>
          </div>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
          <p class="detail-text">{t("Figma（UIデザイン）", "Figma (UI design)")}<br />{t("Illustrator（イラスト）", "Illustrator (illustrations)")}<br />{t("Photoshop（バナー制作）", "Photoshop (banners)")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("成果", "Results")}</h4>
          <p class="detail-text">{t("リリース後、アプリヘルススコア（クラッシュ・エンゲージメント・CVRなどの総合指標）が改善。アクティブユーザー数も増加し、安定した利用規模を維持しています。", "After release, the app health score (a combined measure of crashes, engagement, conversion and more) improved. Active users also increased, and the app continues to maintain a stable user base.")}</p>
        </div>
      </div>

      <div class="case-showcase-2col">
        <div>
          <img src="/images/app-detail01.png" class="imgbox" alt={t("v4.0「ニコラ」告知ビジュアル", "v4.0 “Nikola” announcement visual")} />
          <p class="detail-text" style="margin-top:16px;">{t("v4.0「ニコラ」リリース時の告知ビジュアル。ポイントのステージカードや口コミなど、アップデートの内容をひと目で伝える構成にしました。", "The announcement visual for the v4.0 “Nikola” release, designed to show the update’s highlights — point stage cards, reviews and more — at a glance.")}</p>
        </div>
        <div>
          <img src="/images/app-detail02.png" class="imgbox" alt={t("EVライフプログラム ビジュアル", "EV Life Program visual")} />
          <p class="detail-text" style="margin-top:16px;">{t("新しく始まる「EVライフプログラム」のビジュアル。ENTRY・GOLD・PLATINUMのステージを表彰台で表現し、特別感と楽しさを伝えています。", "The visual for the new “EV Life Program”. The ENTRY, GOLD and PLATINUM stages are shown on a podium to convey a sense of occasion and fun.")}</p>
        </div>
      </div>

      <div class="case-mockup">
        <img src="/images/app-thedesign.png" class="no-shadow" alt={t("THE DESIGN — EV充電エネチェンジ アプリ", "THE DESIGN — EV Charge ENECHANGE app")} />
      </div>

      <div class="case-cta" style="text-align:center;margin-top:4px;">
        <a href="#contact" class="btn">Contact Me</a>
      </div>
        <button type="button" class="case-more-btn case-more-close">{t("閉じる", "Close")}</button>
      </details>
    </div>

    <!-- ============ CASE 02 ============ -->
    <!-- v5 full redesign (cancelled before release). Screens: v4 file uNmcvS0CxlLMOhBfVYs94N (before), v5 file jf5THs0AD0FSUwk1oxZIsR (after) -->
    <div id="case-02" class="case-anchor" style="margin-top:120px;">
      <div class="case-media-grid">
        <a
          href="/images/lg-top.webp"
          target="_blank"
          rel="noopener"
          class="shot-panel lightbox-trigger"
          style="display:flex;align-items:center;justify-content:center;"
        >
          <img src="/images/lg-top.webp" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("スタイルガイド Vol.5 の表紙", "Cover of Styleguide Vol.5")} />
          <span class="expand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <div>
          <div class="case-num">CASE 02</div>
          <h3 class="disp case-title-lg">{t("EV充電エネチェンジ アプリ 全体リニューアル", "EV Charge ENECHANGE App Redesign")}</h3>
          <hr class="divider" style="margin:24px 0;max-width:120px;" />
          <div class="meta-label">{t("期間", "Duration")}</div>
          <p class="meta-value">{t("3ヶ月", "3 months")}</p>
          <div class="meta-label">{t("チーム構成", "Team")}</div>
          <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("ディレクター1", "1 director")}<br />{t("エンジニア2", "2 engineers")}</p>
        </div>
      </div>

      <details class="case-more">
        <summary class="case-more-btn"><span class="when-closed">{t("詳しく見る", "View details")}</span><span class="when-open">{t("閉じる", "Close")}</span></summary>
      <div class="ghost-mid">DETAILS</div>

      <div class="grid-3 detail-grid">
        <div>
          <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
          <p class="detail-text">{t("EV充電エネチェンジ アプリは機能追加を重ねる一方で、見た目や操作の土台となるUIの更新が長く止まっていました。毎日使われるアプリだからこそ、変わったことがすぐ伝わり、屋外や車内でも迷わず使えるよう、デザインシステムから画面まで全体を作り直す計画でした。", "Features kept being added to the EV Charge ENECHANGE app, but the underlying UI hadn’t been updated in a long time. Because people use it every day, the plan was to rebuild everything from the design system to each screen — so the change is obvious and the app is easy to use outdoors or in the car.")}</p>
