---
import { useT } from "../i18n.js";

const { lang = "ja" } = Astro.props;
const t = useT(lang);

// サイドのタグは「日本語版での top（px）＋ 英語版で各 CASE がずれる量」で配置
// （英語は文章が長く CASE の位置が下がるため。CASE の高さが変わったら測り直す）
const enShift = [0, 51, 224, 275, 387, 407, 425, 565];
const top = (caseNo, jaTop) => jaTop + (lang === "en" ? enShift[caseNo - 1] : 0);
---

<section id="works" class="section">
  <div
    class="ghost"
    style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(70px,11vw,170px);z-index:0;opacity:.7;"
  >
    WORKS
  </div>

  <!-- CASE 01 tool tags -->
  <div class="sticker" style={`top:${top(1, 280)}px;right:2%;transform:rotate(-6deg);`}>FIGMA</div>
  <div class="sticker" style={`top:${top(1, 400)}px;left:3.5%;transform:rotate(5deg);`}>ILLUSTRATOR</div>

  <!-- CASE 02 tool tags -->
  <div class="sticker" style={`top:${top(2, 3378)}px;right:2%;transform:rotate(-6deg);`}>FIGMA</div>
  <div class="sticker" style={`top:${top(2, 3498)}px;left:3.5%;transform:rotate(5deg);`}>ILLUSTRATOR</div>
  <div class="sticker" style={`top:${top(2, 3618)}px;right:1%;transform:rotate(7deg);`}>PHOTOSHOP</div>

  <!-- CASE 03 tool tags -->
  <div class="sticker" style={`top:${top(3, 6460)}px;right:2%;transform:rotate(-6deg);`}>ILLUSTRATOR</div>
  <div class="sticker" style={`top:${top(3, 6580)}px;left:3.5%;transform:rotate(5deg);`}>PHOTOSHOP</div>
  <div class="sticker" style={`top:${top(3, 6700)}px;right:1%;transform:rotate(7deg);`}>FIGMA</div>

  <!-- CASE 04 tool tags -->
  <div class="sticker" style={`top:${top(4, 10004)}px;right:2%;transform:rotate(-6deg);`}>FIGMA</div>
  <div class="sticker" style={`top:${top(4, 10124)}px;left:3.5%;transform:rotate(5deg);`}>PHOTOSHOP</div>
  <div class="sticker" style={`top:${top(4, 10244)}px;right:1%;transform:rotate(7deg);`}>ILLUSTRATOR</div>

  <!-- CASE 05 tool tags -->
  <div class="sticker" style={`top:${top(5, 12995)}px;right:2%;transform:rotate(-6deg);`}>ILLUSTRATOR</div>
  <div class="sticker" style={`top:${top(5, 13115)}px;left:3.5%;transform:rotate(5deg);`}>FIGMA</div>

  <!-- CASE 06 tool tags -->
  <div class="sticker" style={`top:${top(6, 15985)}px;right:2%;transform:rotate(-6deg);`}>PHOTOSHOP</div>
  <div class="sticker" style={`top:${top(6, 16105)}px;left:3.5%;transform:rotate(5deg);`}>ADOBE XD</div>
  <div class="sticker" style={`top:${top(6, 16225)}px;right:1%;transform:rotate(7deg);`}>AFTER EFFECTS</div>

  <!-- CASE 07 tool tags -->
  <div class="sticker" style={`top:${top(7, 19098)}px;left:3.5%;transform:rotate(5deg);`}>PHOTOSHOP</div>

  <!-- CASE 08 tool tags -->
  <div class="sticker" style={`top:${top(8, 21916)}px;right:2%;transform:rotate(-6deg);`}>PHOTOSHOP</div>
  <div class="sticker" style={`top:${top(8, 22036)}px;left:3.5%;transform:rotate(5deg);`}>ADOBE XD</div>
  <div class="sticker" style={`top:${top(8, 22156)}px;right:1%;transform:rotate(7deg);`}>WEBFLOW</div>

  <div class="wrap">
    <div class="eyebrow">My Works</div>
    <h2 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">{t("代表的な制作実績", "Selected Works")}</h2>

    <!-- ============ CASE 01 ============ -->
    <div style="margin-top:80px;">
      <div class="case-media-grid">
        <a
          href="/images/badge-full.jpg"
          target="_blank"
          rel="noopener"
          class="shot-panel lightbox-trigger"
          style="display:flex;align-items:center;justify-content:center;"
        >
          <img src="/images/badge-top.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("EV充電エネチェンジ アプリ マイバッジ機能", "EV Charge ENECHANGE app — My Badge feature")} />
          <span class="expand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <div>
          <div class="case-num">CASE 01</div>
          <h3 class="disp case-title-lg">{t("EV充電エネチェンジ アプリ v4.1.0 — 新機能「マイバッジ」", "EV Charge ENECHANGE App v4.1.0 — New “My Badge” Feature")}</h3>
          <hr class="divider" style="margin:24px 0;max-width:120px;" />
          <div class="meta-label">{t("期間", "Duration")}</div>
          <p class="meta-value">{t("約1ヶ月", "About 1 month")}</p>
          <div class="meta-label">{t("チーム構成", "Team")}</div>
          <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("ディレクター1", "1 director")}<br />{t("エンジニア2", "2 engineers")}</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
            <a href="https://apps.apple.com/jp/app/id911721775" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">App Store ↗</a>
            <a href="https://play.google.com/store/apps/details?id=net.evsmart" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">Google Play ↗</a>
            <a href="https://ev-plus.jp/news/important-notice/v4-1-0-update/" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">{t("v4.1.0 アップデートのお知らせ ↗", "v4.1.0 release notes (JP) ↗")}</a>
          </div>
        </div>
      </div>

      <div class="ghost-mid">DETAILS</div>

      <div class="grid-3 detail-grid">
        <div>
          <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
          <p class="detail-text">{t("2026年7月31日配信のv4.1.0で追加された新機能「マイバッジ」。充電や口コミ投稿など、アプリの利用に応じてバッジを獲得・コレクションできる機能です。v4.0「ニコラ」で始まったEVライフプログラムに続き、「使うたびに楽しい」アプリ体験をさらに広げることが求められました。", "“My Badge”, a new feature added in v4.1.0 (released July 31, 2026). Users earn and collect badges as they use the app — charging, posting reviews and more. Following the EV Life Program launched in v4.0 “Nikola”, the goal was to further extend an app experience that’s “fun every time you use it”.")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
          <ul class="detail-list">
            <li>{t("アプリを継続して使う動機づけ", "Give users a reason to keep using the app")}</li>
            <li>{t("口コミ・写真投稿の促進", "Encourage review and photo posts")}</li>
            <li>{t("アプリへのロイヤルティを高め、充電利用と売上につなげる", "Build loyalty to the app, driving charging usage and revenue")}</li>
          </ul>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
          <ul class="detail-list">
            <li>{t("マイバッジ画面のUI/UXデザイン", "UI/UX design of the My Badge screen")}</li>
            <li>{t("バッジ獲得時のモーダルのデザイン", "Design of the badge-earned modal")}</li>
            <li>{t("ホーム画面のマイバッジ導線バナー", "My Badge entry banner on the Home screen")}</li>
            <li>{t("バッジのデザイン", "Badge design")}</li>
            <li>{t("プロトタイピング", "Prototyping")}</li>
          </ul>
        </div>
        <div>
          <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
          <p class="detail-text"><b style="color:var(--ink);">{t("1. 集めたくなるコレクション画面", "1. A collection screen that makes you want to collect")}</b><br />{t("充電・おでかけ・口コミなど、アクションの種類ごとにバッジを並べ、ブロンズ・シルバー・ゴールドと段階的に色が変わるデザインに。次に何を目指せばいいかがひと目でわかり、「全部そろえたい」と思える一覧にしました。", "Badges are grouped by type of action — charging, going out, reviews and more — and change color step by step from bronze to silver to gold. Users can see at a glance what to aim for next, and the list makes them want to complete the set.")}</p>
          <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. 獲得の瞬間を祝う演出", "2. Celebrating the moment you earn a badge")}</b><br />{t("バッジを獲得すると、紙吹雪とともにバッジと獲得条件を表示するモーダルを用意。達成感を味わえる瞬間をつくり、次のアクションへの意欲につなげています。", "When a badge is earned, a modal shows the badge and how it was earned, with confetti. It creates a moment of accomplishment that motivates the next action.")}</p>
          <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("3. ステージと連動したアイコンフレーム", "3. Icon frames linked to program stages")}</b><br />{t("EVライフプログラムのPlatinum・Diamondステージに応じたアイコンフレームを選べるようにし、プログラムとの一体感と特別感を演出。ライト・ダークの両モードでも世界観が崩れないよう配色を調整しました。", "Users can choose icon frames that match their EV Life Program stage (Platinum, Diamond), tying the feature to the program and adding a sense of status. Colors were tuned so the look holds up in both light and dark mode.")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
          <ul class="detail-list">
            <li>{t("集める楽しさ", "The joy of collecting")}</li>
            <li>{t("達成感", "Sense of accomplishment")}</li>
            <li>{t("特別感", "Feeling special")}</li>
          </ul>
        </div>
        <div>
          <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
          <div class="swatch-row">
            <div class="swatch"><span style="background:#A04276;"></span>#A04276</div>
            <div class="swatch"><span style="background:#662B4F;"></span>#662B4F</div>
            <div class="swatch"><span style="background:#C60D31;"></span>#C60D31</div>
            <div class="swatch"><span style="background:#FFE2AB;"></span>#FFE2AB</div>
            <div class="swatch"><span style="background:#121212;"></span>#121212</div>
          </div>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
          <p class="detail-text">{t("Figma（UIデザイン）", "Figma (UI design)")}<br />{t("Illustrator（バッジデザイン）", "Illustrator (badge design)")}</p>
        </div>
      </div>

      <div class="case-showcase-2col">
        <div>
          <img src="/images/badge-detail01.png" class="imgbox" alt={t("マイバッジ画面（ライト・ダーク）", "My Badge screen (light and dark)")} />
          <p class="detail-text" style="margin-top:16px;">{t("マイバッジ画面。アイコンフレームとアクションバッジをカードにまとめ、ライト・ダークどちらのモードでも見やすい配色にしています。", "The My Badge screen. Icon frames and action badges are grouped into cards, with colors that stay easy to read in both light and dark mode.")}</p>
        </div>
        <div>
          <img src="/images/badge-detail02.png" class="imgbox" alt={t("ホームの導線バナーとバッジ獲得モーダル", "Home entry banner and badge-earned modal")} />
          <p class="detail-text" style="margin-top:16px;">{t("ホーム画面の「マイバッジコレクション」バナー（左）と、バッジ獲得時のモーダル（右）。ホームから自然に機能を知ってもらい、獲得の瞬間を印象的に演出しています。", "The “My Badge Collection” banner on the Home screen (left) and the badge-earned modal (right). Users discover the feature naturally from Home, and the moment of earning a badge is made memorable.")}</p>
        </div>
      </div>

      <div class="case-mockup">
        <a href="/images/badge-thedesign3.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;max-width:720px;margin:0 auto;">
          <img src="/images/badge-thedesign3.png" class="no-shadow" alt={t("THE DESIGN — マイバッジ画面と、デザインしたバッジ", "THE DESIGN — My Badge screens and the badges I designed")} />
          <span class="expand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>

      <div class="case-cta" style="text-align:center;margin-top:4px;">
        <a href="#contact" class="btn">Contact Me</a>
      </div>
    </div>

    <!-- ============ CASE 02 ============ -->
    <div style="margin-top:120px;">
      <div class="case-media-grid">
        <a
          href="/images/app-full3.jpg"
          target="_blank"
          rel="noopener"
          class="shot-panel lightbox-trigger"
          style="display:flex;align-items:center;justify-content:center;"
        >
          <img src="/images/app-top3.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("EV充電エネチェンジ アプリ", "EV Charge ENECHANGE app")} />
          <span class="expand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <div>
          <div class="case-num">CASE 02</div>
          <h3 class="disp case-title-lg">{t("EV充電エネチェンジ アプリ改修 — v4.0「ニコラ」メジャーアップデート", "EV Charge ENECHANGE App Redesign — v4.0 “Nikola” Major Update")}</h3>
          <hr class="divider" style="margin:24px 0;max-width:120px;" />
          <div class="meta-label">{t("期間", "Duration")}</div>
          <p class="meta-value">{t("約2ヶ月", "About 2 months")}</p>
          <div class="meta-label">{t("チーム構成", "Team")}</div>
          <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("プロジェクトマネージャー1", "1 project manager")}<br />{t("ディレクター1", "1 director")}<br />{t("エンジニア3", "3 engineers")}</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
            <a href="https://apps.apple.com/jp/app/id911721775" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">App Store ↗</a>
            <a href="https://play.google.com/store/apps/details?id=net.evsmart" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">Google Play ↗</a>
            <a href="https://ev-plus.jp/miraene-note/ev-charge-enechange-app-update-nikola/" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">{t("開発チームのインタビュー記事 ↗", "Interview with the dev team (JP) ↗")}</a>
            <a href="https://ev-charge-enechange.jp/for_drivers/ev-life-program/" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">EV Life Program LP ↗</a>
          </div>
        </div>
      </div>

      <div class="ghost-mid">DETAILS</div>

      <div class="grid-3 detail-grid">
        <div>
          <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
          <p class="detail-text">{t("充電スポット検索アプリ「EV充電エネチェンジ」のメジャーアップデート（v4.0「ニコラ」、2026年4月リリース）。充電スポットの検索が中心だったアプリを、ポイントやプリペイド残高、最新ニュースにすぐアクセスできる「EVの総合ポータル」へと進化させる改修が求められました。", "A major update to “EV Charge ENECHANGE”, an app for finding EV charging spots (v4.0 “Nikola”, released April 2026). The goal was to evolve an app built mainly around searching for charging spots into an “all-in-one EV portal” where users can instantly access their points, prepaid balance and the latest news.")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
          <ul class="detail-list">
            <li>{t("使いやすいUIによるマイページの利便性向上", "Make My Page more convenient with an easy-to-use UI")}</li>
            <li>{t("EVライフプログラムへの参加促進", "Encourage sign-ups for the EV Life Program")}</li>
            <li>{t("アプリへの愛着（ロイヤルティ）を高め、充電利用と事業成長につなげる", "Build loyalty to the app, driving charging usage and business growth")}</li>
          </ul>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
          <ul class="detail-list">
            <li>{t("v4.0アップデートのUI/UXデザイン", "UI/UX design for the v4.0 update")}</li>
            <li>{t("ホーム画面（新設）のデザイン", "Design of the new Home screen")}</li>
            <li>{t("マイページのデザイン", "Design of My Page")}</li>
            <li>{t("EVライフプログラムLPのデザイン", "Design of the EV Life Program LP")}</li>
          </ul>
        </div>
        <div>
          <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
          <p class="detail-text"><b style="color:var(--ink);">{t("1. 「EVの総合ポータル」としてのホーム画面", "1. A Home screen that works as an “all-in-one EV portal”")}</b><br />{t("検索が中心だったアプリにホーム画面を新設。ポイントやプリペイド残高、最新ニュースなど、ユーザーが今知りたい情報にすぐアクセスできる構成にしました。", "I added a new Home screen to an app that had been centered on search, structured so users can instantly reach what they want to know right now — points, prepaid balance, the latest news and more.")}</p>
          <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. 特別感と直感性を両立したプログラム画面", "2. Program screens that feel special yet intuitive")}</b><br />{t("新しく始まる「EVライフプログラム」は、ユーザーにとって誇らしく特別なものになるよう、高級感のある洗練されたシンプルなデザインに。アイコンや色でステージの違いが直感的にわかるよう、情報設計にもこだわりました。", "To make the new “EV Life Program” something users feel proud of and special about, I gave it a premium, refined and simple design. I also paid close attention to the information architecture so that icons and colors make the different stages instantly clear.")}</p>
          <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("3. 迷わず使えるマイページ", "3. A My Page that’s easy to navigate")}</b><br />{t("プリペイド残高や登録カードを上部にまとめ、その下にクーポン・充電履歴などのサービス、表示・通知などの設定、ヘルプをグループごとに整理。項目が多くても目的の機能を見つけやすい構成にしました。", "Prepaid balance and registered cards sit together at the top, with services such as coupons and charging history, settings such as display and notifications, and help organized into groups below. Even with many items, users can easily find the feature they need.")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
          <ul class="detail-list">
            <li>{t("高級感・洗練", "Premium & refined")}</li>
            <li>{t("直感的にわかる", "Intuitive")}</li>
            <li>{t("使うたびに楽しい", "Fun every time you use it")}</li>
          </ul>
        </div>
        <div>
          <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
          <div class="swatch-row">
            <div class="swatch"><span style="background:#C60D31;"></span>#C60D31</div>
            <div class="swatch"><span style="background:#7D1631;"></span>#7D1631</div>
            <div class="swatch"><span style="background:#52B9C2;"></span>#52B9C2</div>
            <div class="swatch"><span style="background:#333333;"></span>#333333</div>
            <div class="swatch"><span style="background:#FFFFFF;border:1px solid var(--border);"></span>#FFFFFF</div>
          </div>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
          <p class="detail-text">{t("Figma（UIデザイン）", "Figma (UI design)")}<br />{t("Illustrator（イラスト）", "Illustrator (illustrations)")}<br />{t("Photoshop（バナー制作）", "Photoshop (banners)")}</p>
          <h4 class="disp detail-heading" style="margin-top:32px;">{t("成果", "Results")}</h4>
          <p class="detail-text">{t("リリース後、アプリヘルススコア（クラッシュ・エンゲージメント・CVRなどの総合指標）が改善。アクティブユーザー数も増加し、安定した利用規模を維持しています。", "After release, the app health score (a combined measure of crashes, engagement, conversion and more) improved. Active users also increased, and the app continues to maintain a stable user base.")}</p>
        </div>
      </div>

      <div class="case-showcase-2col">
        <div>
          <img src="/images/app-detail01.png" class="imgbox" alt={t("v4.0「ニコラ」告知ビジュアル", "v4.0 “Nikola” announcement visual")} />
          <p class="detail-text" style="margin-top:16px;">{t("v4.0「ニコラ」リリース時の告知ビジュアル。ポイントのステージカードや口コミなど、アップデートの内容をひと目で伝える構成にしました。", "The announcement visual for the v4.0 “Nikola” release, designed to show the update’s highlights — point stage cards, reviews and more — at a glance.")}</p>
