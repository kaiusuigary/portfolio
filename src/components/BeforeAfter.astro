---
// Before / after comparison slider (drag or use the arrow keys).
// data: { pc: [before, after], sp: [before, after], full: [before, after] }
import { useT } from "../i18n.js";
const { lang, data } = Astro.props;
const t = useT(lang);
---

<section class="section ba-section">
  <div class="wrap">
    <h3 class="detail-heading" style="font-size:18px;text-align:center;">BEFORE / AFTER</h3>
    <p class="detail-text" style="text-align:center;margin-top:10px;">
      {t("つまみを左右に動かすと、現行サイト（左）とリニューアル案（右）を比較できます。", "Drag the handle to compare the current site (left) with the redesign (right).")}
    </p>

    <div class="ba" style="--pos:50%;">
      <picture>
        <source media="(max-width: 699px)" srcset={data.sp[1]} />
        <img class="ba-img" src={data.pc[1]} alt={t("リニューアル案", "Redesign")} />
      </picture>
      <picture class="ba-before">
        <source media="(max-width: 699px)" srcset={data.sp[0]} />
        <img class="ba-img" src={data.pc[0]} alt={t("現行サイト", "Current site")} />
      </picture>
      <span class="ba-label ba-label-l">BEFORE</span>
      <span class="ba-label ba-label-r">AFTER</span>
      <span class="ba-handle" aria-hidden="true"><i></i></span>
      <input class="ba-range" type="range" min="0" max="100" value="50" aria-label={t("ビフォー・アフターの比較位置", "Before / after position")} />
    </div>

    <div class="ba-links">
      <a href={data.full[0]} target="_blank" rel="noopener" class="btn-ghost">{t("現行サイトの全体を見る ↗", "View full current site ↗")}</a>
      <a href={data.full[1]} target="_blank" rel="noopener" class="btn-ghost">{t("リニューアル案の全体を見る ↗", "View full redesign ↗")}</a>
    </div>
  </div>
</section>

<style>
  .ba-section { padding-top: 10px; padding-bottom: 60px; }
  .ba { position: relative; margin: 28px auto 0; max-width: 1100px; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 50px rgba(16, 27, 52, 0.14); user-select: none; touch-action: pan-y; }
  .ba-img { display: block; width: 100%; height: auto; }
  .ba-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-before .ba-img { height: 100%; object-fit: cover; object-position: top; }
  .ba-label { position: absolute; bottom: 14px; padding: 4px 12px; border-radius: 999px; font: 700 12px/1.6 system-ui, sans-serif; letter-spacing: 0.08em; color: #fff; background: rgba(16, 27, 52, 0.72); pointer-events: none; }
  .ba-label-l { left: 14px; }
  .ba-label-r { right: 14px; }
  .ba-handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 0 1px rgba(16, 27, 52, 0.2); pointer-events: none; }
  .ba-handle i { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: #fff; box-shadow: 0 4px 14px rgba(16, 27, 52, 0.25); }
  .ba-handle i::before, .ba-handle i::after { content: ""; position: absolute; top: 50%; width: 8px; height: 8px; margin-top: -4px; border: solid #101b34; border-width: 0 0 2px 2px; }
  .ba-handle i::before { left: 11px; transform: rotate(45deg); }
  .ba-handle i::after { right: 11px; transform: rotate(-135deg); }
  .ba-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ba-range:focus-visible + * { outline: none; }
  .ba:has(.ba-range:focus-visible) { outline: 3px solid var(--accent-2, #1a9bd7); outline-offset: 3px; }
  .ba-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 20px; }
  .ba-links .btn-ghost { font-size: 13px; padding: 10px 20px; display: inline-flex; }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".ba").forEach((el) => {
    const range = el.querySelector<HTMLInputElement>(".ba-range")!;
    const update = () => el.style.setProperty("--pos", range.value + "%");
    range.addEventListener("input", update);
    update();
  });
</script>
