---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kai Usui Portfolio",
  description = "Kai Usui — UI/UX Designer Portfolio. 4カ国語を操るマルチリンガル、14年のキャリア。",
} = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
    />

    <style is:global>
      :root {
        color-scheme: light;
        --bg-1: #f6f8fc;
        --bg-2: #ecf2f9;
        --bg-3: #dee8f7;
        --glass: rgba(255, 255, 255, 0.55);
        --glass-2: rgba(255, 255, 255, 0.78);
        --border: rgba(16, 27, 52, 0.12);
        --border-soft: rgba(16, 27, 52, 0.07);
        --ink: #101b34;
        --ink-soft: #47567a;
        --ink-faint: #7c88a8;
        --accent: #0f70a8;
        --accent-2: #17b8c4;
        --warm: #ff8a5c;
        --panel: #ffffff;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      html {
        scrollbar-color: var(--border) var(--bg-1);
        scrollbar-width: thin;
      }
      ::-webkit-scrollbar {
        width: 12px;
        height: 12px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-1);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 8px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--ink-faint);
      }
      body {
        background: var(--bg-1);
        color: var(--ink);
        font-family: "Noto Sans JP", sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      .disp {
        font-family: "Sora", "Noto Sans JP", sans-serif;
      }
      a {
        color: var(--accent-2);
        text-decoration: none;
      }
      a:hover {
        color: var(--accent);
      }
      ::selection {
        background: var(--accent);
        color: #04070f;
      }
      .wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 48px;
        position: relative;
        z-index: 2;
      }
      .section {
        padding: 120px 0;
        position: relative;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: "Sora", sans-serif;
        font-weight: 700;
        font-size: 12.5px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 18px 0;
      }
      .eyebrow::before {
        content: "";
        width: 26px;
        height: 2px;
        background: var(--accent);
        display: inline-block;
      }
      h1,
      h2,
      h3 {
        margin: 0;
        line-height: 1.05;
      }
      h2 {
        line-height: 1.3;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: #ffffff;
        font-family: "Sora", sans-serif;
        font-weight: 700;
        font-size: 15px;
        padding: 16px 30px;
        border-radius: 100px;
        border: none;
        cursor: pointer;
        box-shadow: 0 16px 34px rgba(76, 141, 255, 0.28);
        transition:
          transform 0.18s ease,
          box-shadow 0.18s ease,
          filter 0.18s ease;
      }
      .btn:hover {
        color: #ffffff;
        filter: brightness(1.12) saturate(1.15);
        transform: translateY(-3px);
        box-shadow: 0 22px 46px rgba(76, 141, 255, 0.48);
      }
      .btn:active {
        transform: translateY(-1px);
        filter: brightness(1.02);
      }
      .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--glass-2);
        color: var(--ink);
        font-family: "Sora", sans-serif;
        font-weight: 600;
        font-size: 15px;
        padding: 15px 28px;
        border-radius: 100px;
        border: 1px solid var(--border);
        backdrop-filter: blur(12px);
        transition:
          transform 0.18s ease,
          background 0.18s ease,
          border-color 0.18s ease,
          color 0.18s ease;
      }
      .btn-ghost:hover {
        border-color: var(--accent-2);
        color: var(--accent-2);
        background: rgba(255, 255, 255, 0.16);
        transform: translateY(-3px);
      }
      .btn-outline {
        display: inline-flex;
        padding: 2px;
        border-radius: 100px;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        transition: transform 0.18s ease;
      }
      .btn-outline:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 36px -12px rgba(15, 112, 168, 0.4);
      }
      .btn-outline-fill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        border-radius: 100px;
        background: #eef4fb;
      }
      .btn-outline-text {
        font-family: "Sora", sans-serif;
        font-weight: 700;
        font-size: 15px;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
      }
      .pill {
        display: inline-flex;
        align-items: center;
        font-family: "Sora", sans-serif;
        font-weight: 600;
        font-size: 12.5px;
        padding: 8px 18px;
        border-radius: 100px;
        border: 1px solid var(--border);
        background: var(--glass);
        color: var(--ink-soft);
      }
      .glass {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 28px;
        backdrop-filter: blur(22px);
        position: relative;
        overflow: hidden;
      }
      .shot-panel {
        background: rgba(255, 255, 255, 0.28);
        border-radius: 18px;
        padding: 14px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.4),
          0 10px 24px -12px rgba(16, 27, 52, 0.18);
      }
      .lightbox-trigger {
        cursor: pointer;
        position: relative;
        transition: filter 0.2s ease;
      }
      .lightbox-trigger:hover {
        filter: brightness(0.97);
      }
      .lightbox-trigger .expand-icon {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(15, 20, 30, 0.55);
        backdrop-filter: blur(6px);
        color: #fff;
        opacity: 0;
        transform: scale(0.9);
        transition:
          opacity 0.2s ease,
          transform 0.2s ease;
        pointer-events: none;
      }
      .lightbox-trigger:hover .expand-icon {
        opacity: 1;
        transform: scale(1);
      }
      .imgbox {
        width: 100%;
        display: block;
        border-radius: 14px;
        object-fit: cover;
      }
      .tool-icon {
        display: inline-flex;
        position: relative;
        transform: rotate(var(--rot));
        transition:
          transform 0.28s ease,
          box-shadow 0.28s ease;
      }
      .tool-icon--glass {
        padding: 14px;
        border-radius: 24px;
        background: var(--glass);
        box-shadow:
          0 8px 20px -8px rgba(16, 27, 52, 0.25),
          0 2px 8px -2px rgba(16, 27, 52, 0.15);
        backdrop-filter: blur(18px);
      }
      .tool-icon::before {
        content: "";
        position: absolute;
        inset: -34%;
        z-index: -1;
        border-radius: 26%;
        background: radial-gradient(
          circle,
          rgba(var(--glow), 0.28),
          rgba(var(--glow), 0.09) 45%,
          transparent 72%
        );
        filter: blur(18px);
      }
      .tool-icon img {
        width: 62px;
        height: 62px;
        border-radius: 14px;
        display: block;
        box-shadow:
          0 20px 30px -12px rgba(16, 27, 52, 0.3),
          0 8px 16px -8px rgba(16, 27, 52, 0.22);
        transition: box-shadow 0.28s ease;
      }
      .tool-icon:hover {
        transform: rotate(0deg) translateY(-10px) scale(1.06);
      }
      .tool-icon:hover img {
        box-shadow:
          0 28px 44px -10px rgba(16, 27, 52, 0.38),
          0 12px 22px -6px rgba(16, 27, 52, 0.28);
      }
      .tools-row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 20px;
      }
      .tool-box {
        width: 96px;
        height: 96px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        box-shadow:
          0 8px 20px -8px rgba(16, 27, 52, 0.25),
          0 2px 8px -2px rgba(16, 27, 52, 0.15);
        backdrop-filter: blur(18px);
      }
      .tool-box img {
        width: 72px;
        height: 72px;
        object-fit: contain;
        display: block;
      }
      .sticker {
        position: absolute;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--glass-2);
        border: 1px solid var(--border);
        backdrop-filter: blur(16px);
        border-radius: 999px;
        padding: 11px 22px 11px 16px;
        font-family: "Sora", sans-serif;
        font-weight: 700;
        font-size: 12.5px;
        letter-spacing: 0.06em;
        color: var(--ink);
        box-shadow: 0 14px 30px -10px rgba(16, 27, 52, 0.22);
        white-space: nowrap;
      }
      .sticker::before {
        content: "";
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 1.5px dashed var(--accent-2);
        flex: none;
      }
      .ghost {
        font-family: "Sora", sans-serif;
        font-weight: 800;
        background: linear-gradient(
          180deg,
          rgba(16, 27, 52, 0.1),
          rgba(16, 27, 52, 0.015)
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        white-space: nowrap;
        user-select: none;
        pointer-events: none;
        letter-spacing: -0.02em;
      }
      .divider {
        height: 1px;
        background: var(--border-soft);
        border: none;
      }

      /* Responsive layout utilities */
      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
      }
      .grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 32px;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        gap: 48px;
        align-items: center;
      }
      .hero-visual {
        position: relative;
        display: flex;
        justify-content: center;
        align-self: center;
      }
      #home {
        position: relative;
        padding-top: 44px;
        padding-bottom: 150px;
      }
      #about {
        padding-top: 160px;
      }
      #home::before {
        content: "";
        position: absolute;
        inset: -140px 0 0 0;
        z-index: 0;
        background: linear-gradient(
            135deg,
            rgba(15, 112, 168, 0.22),
            rgba(23, 184, 196, 0.16) 40%,
            rgba(162, 89, 255, 0.12) 68%,
            rgba(238, 243, 251, 0) 100%
          ),
          radial-gradient(60% 55% at 78% 8%, rgba(23, 184, 196, 0.3), transparent 70%),
          radial-gradient(50% 50% at 8% 85%, rgba(15, 112, 168, 0.24), transparent 70%);
        pointer-events: none;
      }
      #home::after {
        content: "";
        position: absolute;
        inset: -140px 0 0 0;
        z-index: 0;
        background: rgba(255, 255, 255, 0.38);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
        pointer-events: none;
      }
      .case-media-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 24px;
      }
      .about-card {
        padding: 36px;
      }
      .case-num {
        font-family: "Sora", sans-serif;
        font-weight: 800;
        font-size: clamp(24px, 3.2vw, 42px);
        letter-spacing: 0.08em;
        color: var(--accent);
      }
      .case-title-lg {
        font-size: clamp(19px, 1.8vw, 23px);
        font-weight: 800;
        margin-top: 12px;
        color: var(--ink);
        line-height: 1.4;
      }
      .meta-label {
        font-family: "Sora", sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: var(--accent);
        margin-top: 18px;
      }
      .meta-value {
        font-size: 16.5px;
        line-height: 1.7;
        color: var(--ink-soft);
        margin: 6px 0 0 0;
      }
      .ghost-mid {
        font-family: "Sora", sans-serif;
        font-weight: 800;
        font-size: clamp(40px, 6vw, 76px);
        text-align: center;
        color: var(--border);
        margin: 100px 0 28px 0;
        user-select: none;
      }
      .detail-grid {
        text-align: center;
      }
      .detail-heading {
        font-size: 23px;
        font-weight: 800;
        color: var(--accent);
      }
      .detail-text {
        font-size: 16.5px;
        line-height: 1.85;
        color: var(--ink-soft);
        text-align: left;
      }
      .detail-list {
        font-size: 16.5px;
        text-align: left;
        line-height: 1.9;
        color: var(--ink-soft);
        margin: 8px 0 0 0;
        padding-left: 18px;
      }
      .swatch-row {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 12px;
      }
      .swatch {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: var(--ink-soft);
      }
      .swatch span {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        display: inline-block;
      }
      .case-showcase {
        margin-top: 56px;
      }
      .case-showcase-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        margin-top: 56px;
      }
      .case-mockup {
        margin-top: 40px;
        text-align: center;
      }
      .case-mockup img {
        max-width: 720px;
        width: 100%;
        border-radius: 16px;
        box-shadow: 0 40px 70px -20px rgba(16, 27, 52, 0.25);
      }
      .case-mockup img.no-shadow {
        border-radius: 0;
        box-shadow: none;
      }
      .contact-panel {
        padding: 76px 56px;
        text-align: center;
      }
      .case-cta {
        margin-bottom: 160px;
      }
      .projects-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
      }
      .project-card {
        cursor: pointer;
        transition: transform 0.2s ease;
      }
      .project-card:hover {
        transform: translateY(-4px);
      }
      .project-card img {
        transition: filter 0.2s ease;
      }
      .project-card:hover img {
        filter: brightness(0.94);
      }
      .stat-row {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        flex-wrap: wrap;
      }

      /* Nav */
      .nav-bar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 30px;
        font-family: "Sora", sans-serif;
        font-weight: 600;
        font-size: 13.5px;
      }
      .nav-toggle-checkbox {
        display: none;
      }
      .nav-toggle-btn {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--glass-2);
        border: 1px solid var(--border);
        cursor: pointer;
        flex: none;
      }
      .nav-toggle-btn span {
        display: block;
        width: 18px;
        height: 2px;
        margin: 0 auto;
        background: var(--ink);
        border-radius: 2px;
      }

      @media (max-width: 1650px) {
        .tool-icon {
          display: none;
        }
      }

      @media (max-width: 1060px) {
        #home {
          padding-bottom: 30px;
        }
        #about {
          padding-top: 40px;
        }
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 0;
        }
        .hero-visual {
          margin-top: 40px;
        }
        .hero-hello {
          top: 24px !important;
        }
        .hero-title {
          margin-top: -12px !important;
        }
        .sticker {
          display: none;
        }
        .contact-float-card {
          display: none;
        }
        .nav-toggle-btn {
          display: flex;
        }
        .nav-links {
          display: none;
          position: absolute;
          top: calc(100% + 14px);
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          gap: 14px;
          background: var(--bg-2);
          border: 1px solid var(--border);
          border-radius: 20px;
          padding: 22px;
          box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
          z-index: 40;
        }
        .nav-toggle-checkbox:checked ~ .nav-links {
          display: flex;
        }
        .nav-links a.btn {
          justify-content: center;
        }
        .case-cta {
          margin-bottom: 80px;
        }
      }

      @media (max-width: 900px) {
        .projects-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 780px) {
        h2 {
          line-height: 1.4;
        }
        .wrap {
          padding: 0 22px;
        }
        .section {
          padding: 80px 0;
        }
        .grid-2,
        .grid-3,
        .case-media-grid,
        .case-showcase-2col {
          grid-template-columns: 1fr;
        }
        .ghost-mid {
          margin: 64px 0 20px 0;
        }
        .about-card {
          padding: 24px;
        }
        .contact-panel {
          padding: 48px 26px;
        }
      }

      @media (max-width: 560px) {
        .projects-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
