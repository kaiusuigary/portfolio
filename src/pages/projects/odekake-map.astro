---
import Layout from "../../layouts/Layout.astro";
import Contact from "../../components/Contact.astro";
import ToolStickers from "../../components/ToolStickers.astro";
import { otherProjects } from "../../data/otherProjects.js";

const project = otherProjects.find((p) => p.slug === "odekake-map");
---

<Layout title={`${project.label} — Kai Usui Portfolio`} description={project.concept}>
  <div style="min-height:100vh;position:relative;background:#eef4fb;">
    <div style="position:sticky;top:18px;z-index:30;display:flex;justify-content:center;padding:0 20px;">
      <div
        class="glass nav-bar"
        style="width:100%;max-width:1400px;border-radius:999px;padding:10px 12px 10px 26px;box-shadow:0 14px 30px -10px rgba(16,27,52,.22);display:flex;align-items:center;justify-content:space-between;"
      >
        <a href="/" style="display:flex;align-items:baseline;gap:8px;color:var(--ink);">
          <span class="disp" style="font-weight:800;font-size:18px;letter-spacing:.02em;">KAI USUI</span>
          <span style="font-size:12.5px;color:var(--ink-faint);">Portfolio</span>
        </a>
        <div style="display:flex;align-items:center;gap:30px;font-family:'Sora',sans-serif;font-weight:600;font-size:13.5px;">
          <a href="/#about" style="color:var(--ink-soft);">About</a>
          <a href="/#works" style="color:var(--ink-soft);">Works</a>
          <a href="/#other" style="color:var(--ink-soft);">Other Projects</a>
          <a href="/#contact" class="btn" style="padding:11px 22px;font-size:13px;">Contact</a>
        </div>
      </div>
    </div>

    <section class="section" style="padding-top:80px;padding-bottom:50px;position:relative;">
      <ToolStickers tools={"Figma（UIデザイン） Illustrator・Photoshop（イラスト）"} />
      <div
        class="ghost"
        style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(60px,10vw,150px);z-index:0;opacity:.7;white-space:nowrap;"
      >
        MY WORKS
      </div>
      <div class="wrap" style="position:relative;z-index:1;">
        <div style="text-align:center;">
          <div class="eyebrow" style="justify-content:center;">Portfolio</div>
          <h1 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">CASE {project.caseNumber}</h1>
          <a href="/#other" style="font-size:13.5px;color:var(--accent-2);display:inline-block;margin-top:10px;">← Back to home</a>
        </div>


        <!-- ============ CASE 11 ============ -->
        <div style="margin-top:56px;">
          <div class="case-media-grid">
            <a
              href="/images/odm-full.jpg"
              target="_blank"
              rel="noopener"
              class="shot-panel lightbox-trigger"
              style="display:flex;align-items:center;justify-content:center;"
            >
              <img src="/images/odm-top.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt="EVsmart Park おでかけマップ" />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <div>
              <div class="case-num">CASE {project.caseNumber}</div>
              <h2 class="disp case-title-lg">おでかけマップ — EVオーナーコミュニティ「EVsmart Park」の投稿マップ</h2>
              <hr class="divider" style="margin:24px 0;max-width:120px;" />
              <div class="meta-label">期間</div>
              <p class="meta-value">約1週間</p>
              <div class="meta-label">チーム構成</div>
              <p class="meta-value">デザイナー1（自身）<br />ディレクター1</p>
              <a href="https://blog.evsmart.net/t/odekake-map/4165" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;margin-top:8px;display:inline-flex;">Live サイトを見る ↗</a>
            </div>
          </div>

          <div class="ghost-mid">DETAILS</div>

          <div class="grid-3 detail-grid">
            <div>
              <h4 class="disp detail-heading">背景・課題</h4>
              <p class="detail-text">EVオーナーが集まるコミュニティ「EVsmart Park」に、メンバーのおでかけ投稿を日本地図の上で見られる「おでかけマップ」を新設しました。「どこへ行ったか」「どこで充電したか」が地図からひと目でわかり、投稿を見る楽しさと、自分も投稿したくなるきっかけをつくることが求められました。</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">目的・KPI</h4>
              <ul class="detail-list">
                <li>おでかけの投稿を増やし、コミュニティを活性化する</li>
                <li>投稿をきっかけに、EVでのおでかけを促す</li>
                <li>おでかけ先での充電利用を増やし、売上につなげる</li>
              </ul>
              <h4 class="disp detail-heading" style="margin-top:32px;">担当範囲</h4>
              <ul class="detail-list">
                <li>おでかけマップのメインビジュアル</li>
                <li>マップのデザイン</li>
                <li>バッジのデザイン（※イラストはリリース直後のため非掲載）</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">アプローチ・工夫点</h4>
              <p class="detail-text"><b style="color:var(--ink);">1. 旅先を思い浮かべるメインビジュアル</b><br />地図をベースに、鳥居やお城、カニ、ラーメン、だるまなど各地の名物を散りばめ、「次はどこへ行こう」とワクワクできるビジュアルにしました。</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">2. ひと目でわかるシンプルな日本地図</b><br />都道府県をシンプルな図形で描き、投稿のある県をグリーンで塗り分けて投稿数を表示。どの地域でどれだけおでかけされているかが、地図を見るだけで伝わるようにしました。</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">3. 見たい投稿にすぐたどり着ける操作</b><br />「みんな / わたし」の切り替えや、充電・観光・食事・温泉などのカテゴリ絞り込みを地図のそばに配置。自分の記録をふり返ったり、気になるジャンルの投稿を探したりしやすくしました。</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">キーワード</h4>
              <ul class="detail-list">
                <li>旅気分・わくわく感</li>
                <li>ひと目でわかる</li>
                <li>集める楽しさ</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">メインカラー</h4>
              <div class="swatch-row">
                <div class="swatch"><span style="background:#10B293;"></span>#10B293</div>
                <div class="swatch"><span style="background:#2F9FDD;"></span>#2F9FDD</div>
                <div class="swatch"><span style="background:#0083AE;"></span>#0083AE</div>
                <div class="swatch"><span style="background:#E2F6FD;border:1px solid var(--border);"></span>#E2F6FD</div>
              </div>
              <h4 class="disp detail-heading" style="margin-top:32px;">使用ツール・技術</h4>
              <p class="detail-text">Figma（UIデザイン）<br />Illustrator・Photoshop（イラスト）</p>
            </div>
          </div>

          <div class="case-showcase-2col">
            <div>
              <a href="/images/odm-detail01.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;">
                <img src="/images/odm-detail01.png" class="imgbox" alt="おでかけマップ メインビジュアル" />
                <span class="expand-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
              <p class="detail-text" style="margin-top:16px;">メインビジュアルは、川や道が走る地図の上に、各地の名所やグルメのイラストを配置。タイトルにはマップのピンを添え、「地図でおでかけを楽しむ」機能であることが伝わるようにしました。</p>
            </div>
            <div>
              <a href="/images/odm-detail02.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;">
                <img src="/images/odm-detail02.png" class="imgbox" alt="おでかけマップの日本地図" />
                <span class="expand-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
              <p class="detail-text" style="margin-top:16px;">日本地図は都道府県を単純な形に整理し、投稿のある県を色と数字で表示。下にはカテゴリの絞り込みを並べ、地図から目的の投稿を探せるようにしました。</p>
            </div>
          </div>

          <div style="margin-top:48px;">
            <a href="/images/odm-dark.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;max-width:960px;margin:0 auto;">
              <img src="/images/odm-dark.png" class="imgbox" alt="おでかけマップ ダークモード" />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <p class="detail-text" style="margin:16px auto 0;max-width:960px;">ダークモードにも対応。地図の塗り分けや投稿数のバッジ、カテゴリの絞り込みは暗い背景でも見やすい配色に調整し、ライトモードと同じ情報がひと目で伝わるようにしました。</p>
          </div>

          <div class="case-mockup">
            <img src="/images/odm-thedesign.png" class="no-shadow" alt="THE DESIGN — おでかけマップ" />
          </div>

          <div class="case-cta" style="text-align:center;margin-top:4px;">
            <a href="#contact" class="btn">Contact Me</a>
          </div>
        </div>
      </div>
    </section>

    <Contact />
  </div>
</Layout>
