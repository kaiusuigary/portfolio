---
import Layout from "../../../layouts/Layout.astro";
import Contact from "../../../components/Contact.astro";
import ProjectNav from "../../../components/ProjectNav.astro";
import ToolStickers from "../../../components/ToolStickers.astro";
import BadgeShowcase from "../../../components/BadgeShowcase.astro";
import { otherProjects, localize } from "../../../data/otherProjects.js";
import { langParams, getLang, useT, localePath } from "../../../i18n.js";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const project = localize(otherProjects.find((p) => p.slug === "odekake-map"), lang);

// Badge illustrations exported from Figma (EVsmartPark_Badge), public/images/odm-badges/<file>.webp
const prefJa = "北海道 青森 岩手 宮城 秋田 山形 福島 茨城 栃木 群馬 埼玉 千葉 東京 神奈川 新潟 富山 石川 福井 山梨 長野 岐阜 静岡 愛知 三重 滋賀 京都 大阪 兵庫 奈良 和歌山 鳥取 島根 岡山 広島 山口 徳島 香川 愛媛 高知 福岡 佐賀 長崎 熊本 大分 宮崎 鹿児島 沖縄".split(" ");
const prefFile = "hokkaido aomori iwate miyagi akita yamagata fukushima ibaraki tochigi gunma saitama chiba tokyo kanagawa niigata toyama ishikawa fukui yamanashi nagano gifu shizuoka aichi mie shiga kyoto osaka hyogo nara wakayama tottori shimane okayama hiroshima yamaguchi tokushima kagawa ehime kochi fukuoka saga nagasaki kumamoto oita miyazaki kagoshima okinawa".split(" ");
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const badgeGroups = [
  {
    title: t("記録バッジ", "Record badges"),
    items: [
      ["1st", "1st", "1st"],
      ["bronze", "ブロンズ", "Bronze"],
      ["silver", "シルバー", "Silver"],
      ["gold", "ゴールド", "Gold"],
      ["platinum", "プラチナ", "Platinum"],
    ],
  },
  { title: t("都道府県バッジ（47種）", "Prefecture badges (47)"), items: prefFile.map((f, i) => [f, prefJa[i], cap(f)]) },
  {
    title: t("地方制覇バッジ", "Region badges"),
    items: [
      ["clear-hokkaido-tohoku", "北海道・東北", "Hokkaido & Tohoku"],
      ["clear-kantou", "関東", "Kanto"],
      ["clear-cyubu", "中部", "Chubu"],
      ["clear-kinki", "近畿", "Kinki"],
      ["clear-chukoku", "中国", "Chugoku"],
      ["clear-shikoku", "四国", "Shikoku"],
      ["clear-kyushuokinawa", "九州・沖縄", "Kyushu & Okinawa"],
    ],
  },
].map((g) => ({ ...g, items: g.items.map(([file, ja, en]) => ({ src: `/images/odm-badges/${file}.webp`, alt: t(`${ja}のバッジ`, `${en} badge`) })) }));
---

<Layout lang={lang} title={`${project.label} — Kai Usui Portfolio`} description={project.concept}>
  <div style="min-height:100vh;position:relative;background:#eef4fb;">
    <ProjectNav lang={lang} />

    <section class="section" style="padding-top:80px;padding-bottom:50px;position:relative;">
      <ToolStickers tools={"Figma（UIデザイン） Illustrator・Photoshop（イラスト）"} />
      <div
        class="ghost"
        style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(60px,10vw,150px);z-index:0;opacity:.7;white-space:nowrap;"
      >
        MY WORKS
      </div>
      <div class="wrap" style="position:relative;z-index:1;">
        <div style="text-align:center;">
          <div class="eyebrow" style="justify-content:center;">Portfolio</div>
          <h1 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">CASE {project.caseNumber}</h1>
          <a href={localePath(lang, "/") + "#other"} style="font-size:13.5px;color:var(--accent-2);display:inline-block;margin-top:10px;">← Back to home</a>
        </div>


        <!-- ============ CASE 12 ============ -->
        <div style="margin-top:56px;">
          <div class="case-media-grid">
            <a
              href="/images/odm-full.jpg"
              target="_blank"
              rel="noopener"
              class="shot-panel lightbox-trigger"
              style="display:flex;align-items:center;justify-content:center;"
            >
              <img src="/images/odm-top.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("EVsmart Park おでかけマップ", "EVsmart Park Outing Map")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <div>
              <div class="case-num">CASE {project.caseNumber}</div>
              <h2 class="disp case-title-lg">{t("おでかけマップ — EVオーナーコミュニティ「EVsmart Park」の投稿マップ", "Outing Map — A Post Map for the EV Owners’ Community “EVsmart Park”")}</h2>
              <hr class="divider" style="margin:24px 0;max-width:120px;" />
              <div class="meta-label">{t("期間", "Duration")}</div>
              <p class="meta-value">{t("約1週間", "About 1 week")}</p>
              <div class="meta-label">{t("チーム構成", "Team")}</div>
              <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("ディレクター1", "1 director")}</p>
              <a href="https://blog.evsmart.net/t/odekake-map/4165" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;margin-top:8px;display:inline-flex;">{t("Live サイトを見る ↗", "View live site ↗")}</a>
            </div>
          </div>

          <div class="ghost-mid">DETAILS</div>

          <div class="grid-3 detail-grid">
            <div>
              <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
              <p class="detail-text">{t("EVオーナーが集まるコミュニティ「EVsmart Park」に、メンバーのおでかけ投稿を日本地図の上で見られる「おでかけマップ」を新設しました。「どこへ行ったか」「どこで充電したか」が地図からひと目でわかり、投稿を見る楽しさと、自分も投稿したくなるきっかけをつくることが求められました。", "We added the “Outing Map” to “EVsmart Park”, a community for EV owners, letting users see members’ trip posts on a map of Japan. The goal was to show at a glance where people went and where they charged, making posts fun to browse and encouraging users to post their own.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
              <ul class="detail-list">
                <li>{t("おでかけの投稿を増やし、コミュニティを活性化する", "Increase trip posts and energize the community")}</li>
                <li>{t("投稿をきっかけに、EVでのおでかけを促す", "Use posts to inspire people to go out by EV")}</li>
                <li>{t("おでかけ先での充電利用を増やし、売上につなげる", "Increase charging at destinations and grow revenue")}</li>
              </ul>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
              <ul class="detail-list">
                <li>{t("おでかけマップのメインビジュアル", "Outing Map main visual")}</li>
                <li>{t("マップのデザイン", "Map design")}</li>
                <li>{t("バッジのデザイン", "Badge design")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
              <p class="detail-text"><b style="color:var(--ink);">{t("1. 旅先を思い浮かべるメインビジュアル", "1. A main visual that brings destinations to mind")}</b><br />{t("地図をベースに、鳥居やお城、カニ、ラーメン、だるまなど各地の名物を散りばめ、「次はどこへ行こう」とワクワクできるビジュアルにしました。", "On a map base, local icons from around Japan — torii gates, castles, crabs, ramen, daruma dolls and more — are scattered across the visual to spark excitement about where to go next.")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. ひと目でわかるシンプルな日本地図", "2. A simple map of Japan that’s clear at a glance")}</b><br />{t("都道府県をシンプルな図形で描き、投稿のある県をグリーンで塗り分けて投稿数を表示。どの地域でどれだけおでかけされているかが、地図を見るだけで伝わるようにしました。", "Prefectures are drawn as simple shapes, and those with posts are filled in green with the number of posts. Just looking at the map shows where and how often members are traveling.")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("3. 見たい投稿にすぐたどり着ける操作", "3. Controls that get you to the posts you want, fast")}</b><br />{t("「みんな / わたし」の切り替えや、充電・観光・食事・温泉などのカテゴリ絞り込みを地図のそばに配置。自分の記録をふり返ったり、気になるジャンルの投稿を探したりしやすくしました。", "An “Everyone / Me” toggle and category filters such as charging, sightseeing, food and hot springs sit right next to the map, making it easy to look back on your own trips or find posts in genres you’re interested in.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
              <ul class="detail-list">
                <li>{t("旅気分・わくわく感", "Travel mood & excitement")}</li>
                <li>{t("ひと目でわかる", "Clear at a glance")}</li>
                <li>{t("集める楽しさ", "The joy of collecting")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
              <div class="swatch-row">
                <div class="swatch"><span style="background:#10B293;"></span>#10B293</div>
                <div class="swatch"><span style="background:#2F9FDD;"></span>#2F9FDD</div>
                <div class="swatch"><span style="background:#0083AE;"></span>#0083AE</div>
                <div class="swatch"><span style="background:#E2F6FD;border:1px solid var(--border);"></span>#E2F6FD</div>
              </div>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
              <p class="detail-text">{t("Figma（UIデザイン）", "Figma (UI design)")}<br />{t("Illustrator・Photoshop（イラスト）", "Illustrator, Photoshop (illustrations)")}</p>
            </div>
          </div>

          <div class="case-showcase-2col">
            <div>
              <a href="/images/odm-detail01.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;">
                <img src="/images/odm-detail01.png" class="imgbox" alt={t("おでかけマップ メインビジュアル", "Outing Map main visual")} />
                <span class="expand-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
              <p class="detail-text" style="margin-top:16px;">{t("メインビジュアルは、川や道が走る地図の上に、各地の名所やグルメのイラストを配置。タイトルにはマップのピンを添え、「地図でおでかけを楽しむ」機能であることが伝わるようにしました。", "The main visual places illustrations of sights and local food from around Japan on a map crossed by rivers and roads. A map pin added to the title signals that this is a feature for enjoying trips on a map.")}</p>
            </div>
            <div>
              <a href="/images/odm-detail02.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;">
                <img src="/images/odm-detail02.png" class="imgbox" alt={t("おでかけマップの日本地図", "Outing Map’s map of Japan")} />
                <span class="expand-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
              <p class="detail-text" style="margin-top:16px;">{t("日本地図は都道府県を単純な形に整理し、投稿のある県を色と数字で表示。下にはカテゴリの絞り込みを並べ、地図から目的の投稿を探せるようにしました。", "The map of Japan simplifies prefectures into basic shapes and shows those with posts using color and numbers. Category filters below let users find the posts they want from the map.")}</p>
            </div>
          </div>

          <div style="margin-top:48px;">
            <a href="/images/odm-dark.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;max-width:960px;margin:0 auto;">
              <img src="/images/odm-dark.png" class="imgbox" alt={t("おでかけマップ ダークモード", "Outing Map in dark mode")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <p class="detail-text" style="margin:16px auto 0;max-width:960px;">{t("ダークモードにも対応。地図の塗り分けや投稿数のバッジ、カテゴリの絞り込みは暗い背景でも見やすい配色に調整し、ライトモードと同じ情報がひと目で伝わるようにしました。", "Dark mode is supported too. The map colors, post-count badges and category filters were adjusted to stay legible on a dark background, so the same information comes across at a glance as in light mode.")}</p>
          </div>

          <BadgeShowcase title={t("バッジデザイン", "Badge Design")} description={t("コミュニティへの投稿を増やすことをゴールに、おでかけの記録に応じて集められるバッジを全59種類デザインしました。投稿を読む・反応するといった「初めての○○」系のバッジや、訪問を続けることでもらえるバッジは、Discourse標準のバッジがすでに担っています。そのため重複させず、マップ側は「地図に載る記録」ならではのバッジに絞りました。都道府県バッジには各地の名所や名物を描き、県の形とピンを添えて「行った場所」がひと目でわかるようにしています。地方ごとの制覇バッジは、地方の形をモチーフにしました。", "With the goal of getting more people posting in the community, I designed all 59 badges that users collect as they log their trips. First-time badges for reading or reacting to posts, and badges for visiting regularly, are already covered by Discourse’s standard badges. So rather than duplicate them, the map’s badges focus on what only it can offer: records that appear on the map. Each prefecture badge features local sights and specialties along with the prefecture’s shape and a pin, so you can see at a glance where you’ve been. The region badges use the shape of each region as their motif.")} groups={badgeGroups} />

          <div class="case-mockup">
            <img src="/images/odm-thedesign.png" class="no-shadow" alt={t("THE DESIGN — おでかけマップ", "THE DESIGN — Outing Map")} />
          </div>

          <div class="case-cta" style="text-align:center;margin-top:4px;">
            <a href="#contact" class="btn">Contact Me</a>
          </div>
        </div>
      </div>
    </section>

    <Contact lang={lang} />
  </div>
</Layout>

