---
import Layout from "../../../layouts/Layout.astro";
import Contact from "../../../components/Contact.astro";
import ProjectNav from "../../../components/ProjectNav.astro";
import ToolStickers from "../../../components/ToolStickers.astro";
import { otherProjects, localize } from "../../../data/otherProjects.js";
import { langParams, getLang, useT, localePath } from "../../../i18n.js";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const project = localize(otherProjects.find((p) => p.slug === "product-lineup"), lang);

---

<Layout lang={lang} title={`${project.label} — Kai Usui Portfolio`} description={project.concept}>
  <div style="min-height:100vh;position:relative;background:#eef3f8;">
    <ProjectNav lang={lang} />

    <section class="section" style="padding-top:80px;padding-bottom:50px;position:relative;">
      <ToolStickers tools={"Photoshop"} />
      <div
        class="ghost"
        style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(60px,10vw,150px);z-index:0;opacity:.7;white-space:nowrap;"
      >
        MY WORKS
      </div>
      <div class="wrap" style="position:relative;z-index:1;">
        <div style="text-align:center;">
          <div class="eyebrow" style="justify-content:center;">Portfolio</div>
          <h1 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">CASE {project.caseNumber}</h1>
          <a href={localePath(lang, "/") + "#other"} style="font-size:13.5px;color:var(--accent-2);display:inline-block;margin-top:10px;">← Back to home</a>
        </div>

        <div style="margin-top:56px;">
          <div class="case-media-grid">
            <a
              href="/images/case2-full.jpg"
              target="_blank"
              rel="noopener"
              class="shot-panel lightbox-trigger"
              style="display:flex;align-items:center;justify-content:center;"
            >
              <img src="/images/case2-top.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("LEDラインアップページ LP", "LED lineup page")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <div>
              <div class="case-num">CASE {project.caseNumber}</div>
              <h2 class="disp case-title-lg">{t("大手企業の既存商品ラインアップページ リニューアル", "Product Lineup Page Redesign for a Major Company")}</h2>
              <hr class="divider" style="margin:24px 0;max-width:120px;" />
              <div class="meta-label">{t("期間", "Duration")}</div>
              <p class="meta-value">{t("約6ヶ月", "About 6 months")}</p>
              <div class="meta-label">{t("チーム構成", "Team")}</div>
              <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("コーダー4", "4 front-end developers")}<br />{t("ディレクター1", "1 director")}</p>
            </div>
          </div>

          <div class="ghost-mid">DETAILS</div>

          <div class="grid-3 detail-grid">
            <div>
              <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
              <p class="detail-text">{t("既存商品のラインアップページは、情報量の多さや構成の複雑さにより「比較のしづらさ」「目的情報への到達しづらさ」といった課題を抱えていました。対象カテゴリが2系統存在し、ページ内でのスムーズな回遊も求められていました。", "Because of the sheer amount of information and its complex structure, the existing product lineup page made products hard to compare and the right information hard to reach. With two product categories, it also needed to let users move smoothly around the page.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
              <ul class="detail-list">
                <li>{t("商品の魅力を直感的に伝えるUIへの改善", "Improve the UI to convey each product’s appeal intuitively")}</li>
                <li>{t("カタログDL数・お問い合わせ件数（CVR）の向上", "Increase catalog downloads and inquiries (CVR)")}</li>
                <li>{t("商品比較のしやすさ向上と離脱率の低下", "Make products easier to compare and reduce bounce rate")}</li>
              </ul>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
              <ul class="detail-list">
                <li>{t("情報設計（導線・構成）", "Information architecture (user flow and structure)")}</li>
                <li>{t("UIデザイン（デザインカンプ）", "UI design (design comps)")}</li>
                <li>{t("多言語対応図版制作（30言語以上）", "Localized graphics (30+ languages)")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
              <p class="detail-text"><b style="color:var(--ink);">{t("1. 情報設計の改善", "1. Improved information architecture")}</b><br />{t("商品サムネイルをファーストビューから多数見せる構成へ変更（1列2個→4個）。不要なグローバルナビを削除し、目的情報への最短導線を確保。カテゴリ間をスムーズに行き来できる構成に。", "Changed the layout to show many product thumbnails from the first view (from 2 to 4 per row). Removed unnecessary global navigation to create the shortest path to the information users want, and made it easy to move between categories.")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. デザインの工夫", "2. Design")}</b><br />{t("落ち着いたグレートーンで商品自体が引き立つように調整し、「現在地」を示すアクセントカラー（青）で選択状態を強調しました。", "A calm gray palette lets the products stand out, while an accent color (blue) indicating “you are here” emphasizes the selected state.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
              <ul class="detail-list">
                <li>{t("シンプルで洗練", "Simple & refined")}</li>
                <li>{t("直感的にわかりやすい", "Intuitive & clear")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
              <div class="swatch-row">
                <div class="swatch"><span style="background:#DCEAEE;"></span>#DCEAEE</div>
                <div class="swatch"><span style="background:#263C5A;"></span>#263C5A</div>
                <div class="swatch"><span style="background:#D3DFEC;"></span>#D3DFEC</div>
                <div class="swatch"><span style="background:#FFFFFF;border:1px solid var(--border);"></span>#FFFFFF</div>
              </div>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
              <p class="detail-text">{t("Photoshop（図版制作・UIデザインカンプ・パーツ設計）", "Photoshop (graphics, UI design comps, component design)")}<br />{t("コーダー連携を意識したモジュールデザイン", "Modular design built for smooth hand-off to developers")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("成果", "Results")}</h4>
              <p class="detail-text">{t("リニューアル後は、カタログDL数やお問い合わせ数（CVR）が前年比5%以上改善。作成したデザインは日本語を含む30以上の言語に展開され、グローバル展開にも大きく貢献しました。", "After the redesign, catalog downloads and inquiries (CVR) improved by more than 5% year over year. The design was rolled out in over 30 languages including Japanese, contributing greatly to the global rollout.")}</p>
            </div>
          </div>

          <div class="case-showcase-2col">
            <div>
              <div class="shot-panel"><img src="/images/case2-before.png" class="imgbox" style="border-radius:10px;" alt="Before" /></div>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">← Before</b><br />{t("左右にグローバルナビが表示され情報量が多く、視線が分散しやすい構成。テキスト中心で目的到達までの負荷が高い設計でした。", "Global navigation on both sides meant a lot of information and scattered attention. The text-heavy design made it hard work to reach the information users wanted.")}</p>
            </div>
            <div>
              <div class="shot-panel"><img src="/images/case2-after.png" class="imgbox" style="border-radius:10px;" alt="After" /></div>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">After →</b><br />{t("不要なナビを削除し、商品サムネイルを上部に集約。カテゴリ間をタブで切り替えられるようにし、比較しやすい導線を設計しました。", "Removed unnecessary navigation and gathered product thumbnails at the top. Tabs let users switch between categories, making products easier to compare.")}</p>
            </div>
          </div>

          <div class="case-mockup">
            <img src="/images/case2-thedesign.png" class="no-shadow" alt={t("THE DESIGN — ラインアップページ デザイン", "THE DESIGN — Lineup page")} />
          </div>

          <div class="case-cta" style="text-align:center;margin-top:4px;">
            <a href="#contact" class="btn">Contact Me</a>
          </div>
        </div>
      </div>
    </section>

    <Contact lang={lang} />
  </div>
</Layout>
