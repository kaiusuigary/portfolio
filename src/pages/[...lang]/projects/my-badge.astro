---
import Layout from "../../../layouts/Layout.astro";
import Contact from "../../../components/Contact.astro";
import ProjectNav from "../../../components/ProjectNav.astro";
import ToolStickers from "../../../components/ToolStickers.astro";
import BadgeShowcase from "../../../components/BadgeShowcase.astro";
import { otherProjects, localize } from "../../../data/otherProjects.js";
import { langParams, getLang, useT, localePath } from "../../../i18n.js";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const project = localize(otherProjects.find((p) => p.slug === "my-badge"), lang);

// CASE 01 マイバッジ: badges exported from Figma (v4 file, frame "medal"), public/images/mybadge-badges/<file>.webp
const myBadgeGroups = [
  {
    title: t("充電回数バッジ", "Charge count badges"),
    items: [["first-charge", "ファースト・チャージ", "First Charge"], ["bronze-charge", "ブロンズ・チャージ", "Bronze Charge"], ["silver-charge", "シルバー・チャージ", "Silver Charge"], ["gold-charge", "ゴールド・チャージ", "Gold Charge"]],
  },
  {
    title: t("おでかけバッジ", "Travel badges"),
    items: [["beginner-traveller", "ビギナー・トラベラー", "Beginner Traveller"], ["traveller", "トラベラー", "Traveller"], ["explorer", "エクスプローラー", "Explorer"], ["grand-master", "グランドマスター", "Grand Master"]],
  },
  {
    title: t("口コミバッジ", "Review badges"),
    items: [["beginner-reporter", "ビギナー・レポーター", "Beginner Reporter"], ["reporter", "レポーター", "Reporter"], ["photographer", "フォトグラファー", "Photographer"], ["top-contributor", "トップ・コントリビューター", "Top Contributor"]],
  },
  {
    title: t("チャレンジバッジ", "Challenge badges"),
    items: [
      ["hotel-stay", "ホテルステイ", "Hotel Stay"], ["golfer", "ゴルファー", "Golfer"], ["smart-shopper", "スマートショッパー", "Smart Shopper"], ["mountain", "マウンテン", "Mountain"], ["island", "アイランド", "Island"],
      ["river", "リバー", "River"], ["night-owl", "ナイトアウル", "Night Owl"], ["early-bird", "アーリーバード", "Early Bird"], ["time-traveler", "タイムトラベラー", "Time Traveler"], ["pioneer", "パイオニア", "Pioneer"],
    ],
  },
  {
    title: t("EVサポーターズ メダル", "EV Supporters medals"),
    items: [["supporters-s1-platinum", "EVサポーターズ メダル", "EV Supporters medal"], ["supporters-s1-gold", "EVサポーターズ メダル", "EV Supporters medal"], ["supporters-s2-platinum", "EVサポーターズ メダル", "EV Supporters medal"], ["supporters-s2-gold", "EVサポーターズ メダル", "EV Supporters medal"], ["supporters-s2-silver", "EVサポーターズ メダル", "EV Supporters medal"], ["supporters-s2-bronze", "EVサポーターズ メダル", "EV Supporters medal"]],
  },
  {
    title: t("都道府県バッジ", "Prefecture badges"),
    items: [["sticker-hokkaido", "北海道", "Hokkaido"], ["sticker-tohoku", "東北", "Tohoku"], ["sticker-kitakanto", "北関東", "Kita-Kanto"], ["sticker-minamikanto", "南関東", "Minami-Kanto"], ["sticker-tokai", "東海", "Tokai"], ["sticker-hokuriku", "北陸", "Hokuriku"], ["sticker-kinki", "近畿", "Kinki"], ["sticker-chugoku", "中国", "Chugoku"], ["sticker-shikoku", "四国", "Shikoku"], ["sticker-kyushu", "九州", "Kyushu"]],
  },
].map((g) => ({ ...g, items: g.items.map(([file, ja, en]) => ({ src: `/images/mybadge-badges/${file}.webp`, alt: t(`${ja}のバッジ`, `${en} badge`) })) }));

---

<Layout lang={lang} title={`${project.label} — Kai Usui Portfolio`} description={project.concept}>
  <div style="min-height:100vh;position:relative;background:#eef4fb;">
    <ProjectNav lang={lang} />

    <section class="section" style="padding-top:80px;padding-bottom:50px;position:relative;">
      <ToolStickers tools={"Figma Illustrator"} />
      <div
        class="ghost"
        style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(60px,10vw,150px);z-index:0;opacity:.7;white-space:nowrap;"
      >
        MY WORKS
      </div>
      <div class="wrap" style="position:relative;z-index:1;">
        <div style="text-align:center;">
          <div class="eyebrow" style="justify-content:center;">Portfolio</div>
          <h1 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">CASE {project.caseNumber}</h1>
          <a href={localePath(lang, "/") + "#other"} style="font-size:13.5px;color:var(--accent-2);display:inline-block;margin-top:10px;">← Back to home</a>
        </div>

        <div style="margin-top:56px;">
          <div class="case-media-grid">
            <a
              href="/images/badge-full.jpg"
              target="_blank"
              rel="noopener"
              class="shot-panel lightbox-trigger"
              style="display:flex;align-items:center;justify-content:center;"
            >
              <img src="/images/badge-top.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("EV充電エネチェンジ アプリ マイバッジ機能", "EV Charge ENECHANGE app — My Badge feature")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <div>
              <div class="case-num">CASE {project.caseNumber}</div>
              <h2 class="disp case-title-lg">{t("EV充電エネチェンジ アプリ v4.1.0 — 新機能「マイバッジ」", "EV Charge ENECHANGE App v4.1.0 — New “My Badge” Feature")}</h2>
              <hr class="divider" style="margin:24px 0;max-width:120px;" />
              <div class="meta-label">{t("期間", "Duration")}</div>
              <p class="meta-value">{t("約1ヶ月", "About 1 month")}</p>
              <div class="meta-label">{t("チーム構成", "Team")}</div>
              <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("ディレクター1", "1 director")}<br />{t("エンジニア2", "2 engineers")}</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
                <a href="https://apps.apple.com/jp/app/id911721775" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">App Store ↗</a>
                <a href="https://play.google.com/store/apps/details?id=net.evsmart" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">Google Play ↗</a>
                <a href="https://ev-plus.jp/news/important-notice/v4-1-0-update/" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;display:inline-flex;">{t("v4.1.0 アップデートのお知らせ ↗", "v4.1.0 release notes (JP) ↗")}</a>
              </div>
            </div>
          </div>

          <div class="ghost-mid">DETAILS</div>

          <div class="grid-3 detail-grid">
            <div>
              <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
              <p class="detail-text">{t("2026年7月31日配信のv4.1.0で追加された新機能「マイバッジ」。充電や口コミ投稿など、アプリの利用に応じてバッジを獲得・コレクションできる機能です。v4.0「ニコラ」で始まったEVライフプログラムに続き、「使うたびに楽しい」アプリ体験をさらに広げることが求められました。", "“My Badge”, a new feature added in v4.1.0 (released July 31, 2026). Users earn and collect badges as they use the app — charging, posting reviews and more. Following the EV Life Program launched in v4.0 “Nikola”, the goal was to further extend an app experience that’s “fun every time you use it”.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
              <ul class="detail-list">
                <li>{t("アプリを継続して使う動機づけ", "Give users a reason to keep using the app")}</li>
                <li>{t("口コミ・写真投稿の促進", "Encourage review and photo posts")}</li>
                <li>{t("アプリへのロイヤルティを高め、充電利用と売上につなげる", "Build loyalty to the app, driving charging usage and revenue")}</li>
              </ul>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
              <ul class="detail-list">
                <li>{t("マイバッジ画面のUI/UXデザイン", "UI/UX design of the My Badge screen")}</li>
                <li>{t("バッジ獲得時のモーダルのデザイン", "Design of the badge-earned modal")}</li>
                <li>{t("ホーム画面のマイバッジ導線バナー", "My Badge entry banner on the Home screen")}</li>
                <li>{t("バッジのデザイン", "Badge design")}</li>
                <li>{t("プロトタイピング", "Prototyping")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
              <p class="detail-text"><b style="color:var(--ink);">{t("1. 集めたくなるコレクション画面", "1. A collection screen that makes you want to collect")}</b><br />{t("充電・おでかけ・口コミなど、アクションの種類ごとにバッジを並べ、ブロンズ・シルバー・ゴールドと段階的に色が変わるデザインに。次に何を目指せばいいかがひと目でわかり、「全部そろえたい」と思える一覧にしました。", "Badges are grouped by type of action — charging, going out, reviews and more — and change color step by step from bronze to silver to gold. Users can see at a glance what to aim for next, and the list makes them want to complete the set.")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. 獲得の瞬間を祝う演出", "2. Celebrating the moment you earn a badge")}</b><br />{t("バッジを獲得すると、紙吹雪とともにバッジと獲得条件を表示するモーダルを用意。達成感を味わえる瞬間をつくり、次のアクションへの意欲につなげています。", "When a badge is earned, a modal shows the badge and how it was earned, with confetti. It creates a moment of accomplishment that motivates the next action.")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("3. ステージと連動したアイコンフレーム", "3. Icon frames linked to program stages")}</b><br />{t("EVライフプログラムのPlatinum・Diamondステージに応じたアイコンフレームを選べるようにし、プログラムとの一体感と特別感を演出。ライト・ダークの両モードでも世界観が崩れないよう配色を調整しました。", "Users can choose icon frames that match their EV Life Program stage (Platinum, Diamond), tying the feature to the program and adding a sense of status. Colors were tuned so the look holds up in both light and dark mode.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
              <ul class="detail-list">
                <li>{t("集める楽しさ", "The joy of collecting")}</li>
                <li>{t("達成感", "Sense of accomplishment")}</li>
                <li>{t("特別感", "Feeling special")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
              <div class="swatch-row">
                <div class="swatch"><span style="background:#A04276;"></span>#A04276</div>
                <div class="swatch"><span style="background:#662B4F;"></span>#662B4F</div>
                <div class="swatch"><span style="background:#C60D31;"></span>#C60D31</div>
                <div class="swatch"><span style="background:#FFE2AB;"></span>#FFE2AB</div>
                <div class="swatch"><span style="background:#121212;"></span>#121212</div>
              </div>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
              <p class="detail-text">{t("Figma（UIデザイン）", "Figma (UI design)")}<br />{t("Illustrator（バッジデザイン）", "Illustrator (badge design)")}</p>
            </div>
          </div>

          <div class="case-showcase-2col">
            <div>
              <img src="/images/badge-detail01.png" class="imgbox" alt={t("マイバッジ画面（ライト・ダーク）", "My Badge screen (light and dark)")} />
              <p class="detail-text" style="margin-top:16px;">{t("マイバッジ画面。アイコンフレームとアクションバッジをカードにまとめ、ライト・ダークどちらのモードでも見やすい配色にしています。", "The My Badge screen. Icon frames and action badges are grouped into cards, with colors that stay easy to read in both light and dark mode.")}</p>
            </div>
            <div>
              <img src="/images/badge-detail02.png" class="imgbox" alt={t("ホームの導線バナーとバッジ獲得モーダル", "Home entry banner and badge-earned modal")} />
              <p class="detail-text" style="margin-top:16px;">{t("ホーム画面の「マイバッジコレクション」バナー（左）と、バッジ獲得時のモーダル（右）。ホームから自然に機能を知ってもらい、獲得の瞬間を印象的に演出しています。", "The “My Badge Collection” banner on the Home screen (left) and the badge-earned modal (right). Users discover the feature naturally from Home, and the moment of earning a badge is made memorable.")}</p>
            </div>
          </div>

          <BadgeShowcase
            title={t("バッジデザイン", "Badge Design")}
            description={t("充電・おでかけ・口コミなど、アプリでのアクションに応じて獲得できるバッジを、全38種類デザインしました。段階のあるバッジはブロンズ・シルバー・ゴールドと色が変わり、数字とモチーフで獲得条件がひと目でわかるようにしています。", "I designed all 38 badges that users earn through actions in the app — charging, going out, posting reviews and more. Tiered badges change color from bronze to silver to gold, and numbers and motifs show at a glance what each badge is for.")}
            groups={myBadgeGroups}
            size={84}
            spSize={58}
          />

          <div class="case-mockup">
            <a href="/images/badge-thedesign3.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;max-width:720px;margin:0 auto;">
              <img src="/images/badge-thedesign3.png" class="no-shadow" alt={t("THE DESIGN — マイバッジ画面と、デザインしたバッジ", "THE DESIGN — My Badge screens and the badges I designed")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </div>

          <div class="case-cta" style="text-align:center;margin-top:4px;">
            <a href="#contact" class="btn">Contact Me</a>
          </div>
        </div>
      </div>
    </section>

    <Contact lang={lang} />
  </div>
</Layout>
