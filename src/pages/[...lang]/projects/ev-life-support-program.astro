---
import Layout from "../../../layouts/Layout.astro";
import Contact from "../../../components/Contact.astro";
import ProjectNav from "../../../components/ProjectNav.astro";
import ToolStickers from "../../../components/ToolStickers.astro";
import { otherProjects, localize } from "../../../data/otherProjects.js";
import { langParams, getLang, useT, localePath } from "../../../i18n.js";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const project = localize(otherProjects.find((p) => p.slug === "ev-life-support-program"), lang);
---

<Layout lang={lang} title={`${project.label} — Kai Usui Portfolio`} description={project.concept}>
  <div style="min-height:100vh;position:relative;background:#eef4fb;">
    <ProjectNav lang={lang} />

    <section class="section" style="padding-top:80px;padding-bottom:50px;position:relative;">
      <ToolStickers tools={"Figma（UIデザイン） Illustrator・Photoshop（イラスト）"} />
      <div
        class="ghost"
        style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(60px,10vw,150px);z-index:0;opacity:.7;white-space:nowrap;"
      >
        MY WORKS
      </div>
      <div class="wrap" style="position:relative;z-index:1;">
        <div style="text-align:center;">
          <div class="eyebrow" style="justify-content:center;">Portfolio</div>
          <h1 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">CASE {project.caseNumber}</h1>
          <a href={localePath(lang, "/") + "#other"} style="font-size:13.5px;color:var(--accent-2);display:inline-block;margin-top:10px;">← Back to home</a>
        </div>


        <!-- ============ CASE 11 ============ -->
        <div style="margin-top:56px;">
          <div class="case-media-grid">
            <a
              href="/images/els-full.jpg"
              target="_blank"
              rel="noopener"
              class="shot-panel lightbox-trigger"
              style="display:flex;align-items:center;justify-content:center;"
            >
              <img src="/images/els-top.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("EVライフ応援制度 LP", "EV Life Support Program LP")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <div>
              <div class="case-num">CASE {project.caseNumber}</div>
              <h2 class="disp case-title-lg">{t("EVライフ応援制度 — EV新車購入者向け充電クーポンキャンペーンのLP", "EV Life Support Program — LP for a Charging Coupon Campaign for New EV Buyers")}</h2>
              <hr class="divider" style="margin:24px 0;max-width:120px;" />
              <div class="meta-label">{t("期間", "Duration")}</div>
              <p class="meta-value">{t("約1ヶ月", "About 1 month")}</p>
              <div class="meta-label">{t("チーム構成", "Team")}</div>
              <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("ディレクター2", "2 directors")}<br />{t("エンジニア1", "1 engineer")}</p>
              <a href="https://ev-charge-enechange.jp/for_drivers/campaigns/ev-life-support-program/" target="_blank" rel="noopener" class="btn-ghost" style="font-size:13px;padding:10px 20px;margin-top:8px;display:inline-flex;">{t("Live サイトを見る ↗", "View live site ↗")}</a>
            </div>
          </div>

          <div class="ghost-mid">DETAILS</div>

          <div class="grid-3 detail-grid">
            <div>
              <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
              <p class="detail-text">{t("2025年10月以降にEV・PHEVの新車を購入した方を対象に、EV充電エネチェンジアプリで使える充電クーポン（300円×6回、合計1,800円分）をプレゼントする「EVライフ応援制度」。納車をお祝いし、外出先での「充電デビュー」を安心して迎えてもらうための取り組みです。特典の内容と、登録情報の入力・エントリー・審査という参加までの流れを、わかりやすく伝えるLPが求められました。", "The “EV Life Support Program” gives anyone who bought a new EV or PHEV from October 2025 onward charging coupons for the EV Charge ENECHANGE app (¥300 × 6, ¥1,800 in total). It celebrates their new car and helps them make their first public charge with confidence. The LP needed to clearly explain the perk and the steps to join: entering registration details, entering the program and review.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
              <ul class="detail-list">
                <li>{t("EV・PHEVの購入を検討している方の背中を押し、購入へのモチベーションを高める", "Give people considering an EV or PHEV a push and boost their motivation to buy")}</li>
                <li>{t("新車購入者にアプリでの充電を始めてもらい、継続的な利用につなげる", "Get new-car buyers to start charging with the app and keep using it")}</li>
              </ul>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
              <ul class="detail-list">
                <li>{t("LP全体のデザイン（PC / SP）", "Design of the entire LP (desktop / mobile)")}</li>
                <li>{t("イラスト・図版制作", "Illustrations and graphics")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
              <p class="detail-text"><b style="color:var(--ink);">{t("1. 「最大1,800円分」が目に飛び込むメインビジュアル", "1. A main visual where “up to ¥1,800” jumps out")}</b><br />{t("ブランドカラーのピンクを背景に、特典金額を黄色で大きく配置。まわりに人気のEV車種を並べ、「自分の車も対象だ」と感じてもらえるビジュアルにしました。", "The perk amount is set large in yellow on the brand’s pink background, surrounded by popular EV models so visitors feel “my car qualifies too.”")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. 配布スケジュールをカレンダーで直感的に", "2. An intuitive calendar for the coupon schedule")}</b><br />{t("クーポンが届く奇数月をカレンダーのアイコンで並べ、初回配布月と「配布開始月の例」を添えて、いつ受け取れるかを具体的にイメージできるようにしました。", "The odd-numbered months when coupons arrive are shown as calendar icons, along with the first distribution month and an example start month, so users can picture exactly when they’ll receive them.")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("3. 迷わずエントリーできる3ステップ", "3. Three steps to enter without confusion")}</b><br />{t("「登録情報の入力 → エントリー → クーポン受け取り」を縦のタイムラインで見せ、各ステップにアプリ画面やイラストと行動ボタンを配置。読みながらそのまま手続きを進められる構成にしました。", "“Enter your details → enter the program → receive your coupons” is shown as a vertical timeline, with app screens, illustrations and action buttons at each step, so users can complete the process as they read.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
              <ul class="detail-list">
                <li>{t("楽しい", "Fun")}</li>
                <li>{t("賑やか", "Lively")}</li>
                <li>{t("わくわく", "Exciting")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
              <div class="swatch-row">
                <div class="swatch"><span style="background:#D11B58;"></span>#D11B58</div>
                <div class="swatch"><span style="background:#1B4DD2;"></span>#1B4DD2</div>
                <div class="swatch"><span style="background:#FFD800;"></span>#FFD800</div>
                <div class="swatch"><span style="background:#333333;"></span>#333333</div>
                <div class="swatch"><span style="background:#FFD7E3;border:1px solid var(--border);"></span>#FFD7E3</div>
              </div>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
              <p class="detail-text">{t("Figma（UIデザイン）", "Figma (UI design)")}<br />{t("Illustrator・Photoshop（イラスト）", "Illustrator, Photoshop (illustrations)")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("成果", "Results")}</h4>
              <p class="detail-text">{t("制度の開始後、充電の利用が前年同月比で増加。EV充電エネチェンジの充電器を使うユーザーが増え、充電サービスの売上向上にもつながっています。", "Since the program started, charging usage has risen year over year. More users are using EV Charge ENECHANGE chargers, helping increase charging service revenue.")}</p>
            </div>
          </div>

          <div class="case-showcase-2col">
            <div>
              <a href="/images/els-detail01.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;">
                <img src="/images/els-detail01.png" class="imgbox" alt={t("特典内容とクーポン配布月", "Perk details and coupon distribution months")} />
                <span class="expand-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
              <p class="detail-text" style="margin-top:16px;">{t("特典内容は、300円クーポンの束と「1,800円分」の大きな数字で表現。配布月をカレンダーで並べ、初回配布月と配布開始の例をあわせて示すことで、受け取りまでの流れをイメージしやすくしました。", "The perk is shown as a stack of ¥300 coupons with a large “¥1,800” figure. Distribution months are laid out in a calendar alongside the first distribution month and an example start, making it easy to picture how and when coupons arrive.")}</p>
            </div>
            <div>
              <a href="/images/els-detail02.png" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;">
                <img src="/images/els-detail02.png" class="imgbox" alt={t("エントリー方法の3ステップ", "Three steps to enter")} />
                <span class="expand-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
              <p class="detail-text" style="margin-top:16px;">{t("エントリー方法は3ステップのタイムラインで紹介。アプリの画面イメージや、エントリー・クーポン受け取りのイラストを添え、各ステップの最後に次の行動へ進むボタンを置きました。", "How to enter is introduced as a three-step timeline with app screen images and illustrations of entering and receiving coupons, and a button at the end of each step to move on to the next action.")}</p>
            </div>
          </div>

          <div class="case-mockup">
            <img src="/images/els-thedesign.png" class="no-shadow" alt={t("THE DESIGN — EVライフ応援制度 LP", "THE DESIGN — EV Life Support Program LP")} />
          </div>

          <div class="case-cta" style="text-align:center;margin-top:4px;">
            <a href="#contact" class="btn">Contact Me</a>
          </div>
        </div>
      </div>
    </section>

    <Contact lang={lang} />
  </div>
</Layout>
