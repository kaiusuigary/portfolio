---
import Layout from "../../../layouts/Layout.astro";
import Contact from "../../../components/Contact.astro";
import ProjectNav from "../../../components/ProjectNav.astro";
import ToolStickers from "../../../components/ToolStickers.astro";
import { langParams, getLang, useT, localePath } from "../../../i18n.js";

// Unlisted page (not in otherProjects.js, noindex): v5 full renewal of the
// EV Charge ENECHANGE app, cancelled before release.
// Screens: v4 file uNmcvS0CxlLMOhBfVYs94N (before), v5 file jf5THs0AD0FSUwk1oxZIsR (after,
// page "デザイン" + summary section 53555:69820 "更新のまとめ2026年5-8月").
export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang = getLang(Astro.params.lang);
const t = useT(lang);

const pairs = [
  {
    before: "/images/lg-before-map.webp",
    after: "/images/lg-after-map.webp",
    label: t("マップ", "Map"),
    note: t("ヘッダーとナビをガラスの素材に。ナビは「ホーム・探す・充電・知る・マイページ」に組み直し、「充電」を中央の赤いボタンとして独立させました。", "Header and navigation became glass. The tab bar was rebuilt as Home / Search / Charge / Learn / My Page, with “Charge” pulled out as a red button in the center."),
  },
  {
    before: "/images/lg-before-history.webp",
    after: "/images/lg-after-history.webp",
    label: t("検索（履歴）", "Search (history)"),
    note: t("検索バーとフィルタをガラスの丸ボタンにまとめ、見出しとリストは左揃えに統一しました。", "The search bar and filter became round glass controls, and headings and lists are consistently left-aligned."),
  },
  {
    before: "/images/lg-before-results.webp",
    after: "/images/lg-after-results.webp",
    label: t("検索（結果）", "Search (results)"),
    note: t("文字をRobotoからInterに変え、コントラストを上げて屋外でも読みやすくしました。", "Type moved from Roboto to Inter, with higher contrast so it stays readable outdoors."),
  },
];

// Search filter section 53962:101722: top row = before the full redesign, bottom row = after
const sfScreens = [
  { id: "off", label: t("検索フィルタ（初期状態）", "Search filter (default)") },
  { id: "on", label: t("検索フィルタ（選択あり）", "Search filter (with selections)") },
  { id: "card", label: t("充電カード・アプリ", "Charging cards / apps") },
  { id: "facility", label: t("施設の種類", "Facility types") },
];

const points = [
  [t("iOS・Android共通のガラス表現", "A glass style for iOS and Android"), t("長く止まっていたUIの更新を体験全体の見直しとして行い、変化がひと目で伝わるよう、ガラスのような半透明の素材をデザインシステムに取り入れました。iOSのLiquid Glassを参考にしつつ、Androidでも同じ見た目と使い心地になるよう、OSに依存しない共通の表現として設計。ヘッダーや主要ボタンに使い、EVにふさわしい先進的でプレミアムな印象を目指しました。", "UI updates had stalled, so this was a full review of the experience. To make the change obvious at a glance, I added a translucent, glass-like material to the design system. It takes cues from iOS’s Liquid Glass but was designed as a shared style that looks and feels the same on Android. Used on headers and key buttons, it gives the premium, forward-looking feel an EV brand needs.")],
  [t("フォントの選定", "Choosing the typeface"), t("RobotoからInterに変更しました。屋外の日差しの下や暗い駐車場でも、「90kW」「85%」「25分」のような数字と単位をすぐ読めるように。1・I・lの区別がはっきりしていて、マップ上の小さな文字（10〜12px）もつぶれません。", "I switched from Roboto to Inter, so numbers and units like “90kW”, “85%” and “25 min” read instantly in sunlight or a dark car park. Inter clearly separates 1, I and l, and small map labels (10–12px) stay crisp.")],
  [t("コントラストと色の見直し", "Contrast and color"), t("文字と背景のコントラスト比を高めるよう色を調整し、ライト／ダークの両モードで対になる色を定義しました。色覚の多様性にも配慮し、色だけに頼らずに状態を示します。", "Colors were adjusted for higher text contrast and defined as light/dark pairs. States never rely on color alone, so they also work for people with color vision differences.")],
  [t("左揃えを最優先に", "Left alignment first"), t("iOS・Androidどちらでも自然に読めるよう、見出し・本文・ダイアログを左揃えに統一しました。視線の動きに沿うため、「どこから読むか」で迷わず、内容をすばやく拾えます。", "Headings, body text and dialogs are left-aligned so they read naturally on both iOS and Android. It follows how the eye moves, so users never wonder where to start and can scan content quickly.")],
  [t("「充電」を主役のボタンに", "Charge as the primary action"), t("充電開始はアプリでいちばん大切な行動。ナビのほかの項目から独立させ、ブランドカラーの赤で目立たせ、片手でも押しやすい位置に置きました。", "Starting a charge is the app’s most important action, so it is separated from the other tabs, highlighted in the brand red and placed where a thumb reaches it easily.")],
  [t("ダイナミックアイランドと充電画面", "Dynamic Island and charging screens"), t("ロック画面とダイナミックアイランドで充電の経過時間を見られるようにし、アプリ内の充電画面も同じイラストとアニメーションでそろえ、「ちゃんと充電できている」ことが伝わるようにしました。", "Elapsed charging time now shows on the Lock Screen and Dynamic Island, and the in-app charging screens share the same illustration and animation, so users can see that charging is really working.")],
  [t("ライトモードとダークモード", "Light and dark mode"), t("すべての画面をライト／ダークの両方で設計。白すぎない背景（bgPrimary）を基本にして、長い時間見ても目が疲れにくくしました。", "Every screen was designed in both light and dark. The base background is a soft off-white (bgPrimary) rather than pure white, to be easier on the eyes.")],
  [t("入力済みと未入力を色で分ける", "Filled vs. empty fields"), t("「選択してください」などの未入力の表示と、ユーザーが入力した内容の色をはっきり分け、入力漏れに気づきやすくしました。", "Placeholder text like “Please select” and user-entered values use clearly different colors, so missing fields are easy to spot.")],
];
---

<Layout lang={lang} title={`${t("アプリ全体リニューアル（未リリース）", "App Redesign (Unreleased)")} — Kai Usui Portfolio`} description={t("EV充電エネチェンジ アプリ v5 全体リニューアル", "EV Charge ENECHANGE app v5 redesign")} noindex>
  <div style="min-height:100vh;position:relative;background:#f3f1f6;">
    <ProjectNav lang={lang} />

    <section class="section" style="padding-top:80px;padding-bottom:50px;position:relative;">
      <ToolStickers tools={"Figma（UIデザイン）"} />
      <div
        class="ghost"
        style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(60px,10vw,150px);z-index:0;opacity:.7;white-space:nowrap;"
      >
        MY WORKS
      </div>
      <div class="wrap" style="position:relative;z-index:1;">
        <div style="text-align:center;">
          <div class="eyebrow" style="justify-content:center;">Portfolio</div>
          <h1 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">UNRELEASED</h1>
          <a href={localePath(lang, "/") + "#other"} style="font-size:13.5px;color:var(--accent-2);display:inline-block;margin-top:10px;">← Back to home</a>
        </div>

        <div style="margin-top:56px;">
          <div class="case-media-grid">
            <a
              href="/images/lg-top.webp"
              target="_blank"
              rel="noopener"
              class="shot-panel lightbox-trigger"
              style="display:flex;align-items:center;justify-content:center;"
            >
              <img src="/images/lg-top.webp" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("スタイルガイド Vol.5 の表紙", "Cover of Styleguide Vol.5")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <div>
              <div class="case-num"><span class="lg-badge">{t("リリース前に中止", "Cancelled before release")}</span></div>
              <h2 class="disp case-title-lg">{t("EV充電エネチェンジ アプリ 全体リニューアル", "EV Charge ENECHANGE App Redesign")}</h2>
              <p class="detail-text" style="margin-top:8px;">v5</p>
              <hr class="divider" style="margin:24px 0;max-width:120px;" />
              <div class="meta-label">{t("期間", "Duration")}</div>
              <p class="meta-value">{t("2026年5月〜8月", "May – Aug 2026")}</p>
              <div class="meta-label">{t("チーム構成", "Team")}</div>
              <p class="meta-value">{t("【要記入】", "[TBD]")}</p>
            </div>
          </div>

          <div class="ghost-mid">DETAILS</div>

          <div class="grid-3 detail-grid">
            <div>
              <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
              <p class="detail-text">{t("EV充電エネチェンジ アプリは機能追加を重ねる一方で、見た目や操作の土台となるUIの更新が長く止まっていました。毎日使われるアプリだからこそ、変わったことがすぐ伝わり、屋外や車内でも迷わず使えるよう、デザインシステムから画面まで全体を作り直す計画でした。", "Features kept being added to the EV Charge ENECHANGE app, but the underlying UI hadn’t been updated in a long time. Because people use it every day, the plan was to rebuild everything from the design system to each screen — so the change is obvious and the app is easy to use outdoors or in the car.")}</p>
              <p class="detail-text" style="margin-top:14px;">{t("デザインはほぼ完成していましたが、運営会社の事情によりアプリ自体の提供終了が決まったため、リリース前に中止となりました。【表現要確認】", "The design was nearly finished, but the project was cancelled before release when the company decided to discontinue the app. [wording to confirm]")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
              <p class="detail-text">{t("【要記入】", "[TBD]")}</p>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("コンセプト", "Concept")}</h4>
              <ul class="detail-list">
                <li><b style="color:var(--ink);">Inspired</b> — {t("充電をもっと身近に、スマートな移動体験を", "Make charging feel closer and smarter")}</li>
                <li><b style="color:var(--ink);">Reliable</b> — {t("誰でも、どんな状況でも、迷わず確実に使える", "Anyone, anywhere, without hesitation")}</li>
                <li><b style="color:var(--ink);">Universal</b> — {t("年齢や環境に関わらず、すべてのドライバーへ", "For every driver, whatever their age or situation")}</li>
              </ul>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
              <ul class="detail-list">
                <li>{t("ガラス表現", "Glass UI")}</li>
                <li>{t("屋外でも読める", "Readable outdoors")}</li>
                <li>{t("ライト／ダーク", "Light / Dark")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
              <div class="swatch-row">
                <div class="swatch"><span style="background:#C60D31;"></span>#C60D31</div>
                <div class="swatch"><span style="background:#008198;"></span>#008198</div>
                <div class="swatch"><span style="background:#FFB800;"></span>#FFB800</div>
                <div class="swatch"><span style="background:#F9FAFB;border:1px solid var(--border);"></span>#F9FAFB</div>
              </div>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
              <p class="detail-text">{t("Figma（UIデザイン・デザインシステム）", "Figma (UI design, design system)")}</p>
            </div>
          </div>

          <div class="lg-wide">
            <a href="/images/lg-concept.webp" target="_blank" rel="noopener" class="lightbox-trigger" style="display:block;">
              <img src="/images/lg-concept.webp" loading="lazy" width="960" height="998" alt={t("コンセプト：Inspired / Reliable / Universal", "Concept: Inspired / Reliable / Universal")} />
            </a>
          </div>

          <!-- BEFORE / AFTER -->
          <div class="lg-ba">
            <h4 class="disp detail-heading" style="text-align:center;">BEFORE / AFTER</h4>
            <p class="detail-text" style="margin:12px auto 0;max-width:760px;text-align:center;">{t("左が現行アプリ（v4）、右がリニューアル案（v5）です。", "Current app (v4) on the left, the redesign (v5) on the right.")}</p>
            {pairs.map((p) => (
              <div class="lg-ba-row">
                <figure>
                  <img src={p.before} loading="lazy" alt={`${p.label} — BEFORE`} />
                  <figcaption class="lg-label lg-label--before">BEFORE</figcaption>
                </figure>
                <figure>
                  <img src={p.after} loading="lazy" alt={`${p.label} — AFTER`} />
                  <figcaption class="lg-label lg-label--after">AFTER</figcaption>
                </figure>
                <div class="lg-ba-note">
                  <h5 class="disp">{p.label}</h5>
                  <p class="detail-text">{p.note}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- SEARCH FILTER: top row = before, bottom row = after -->
          <div class="lg-block">
            <h4 class="disp detail-heading" style="text-align:center;">{t("検索フィルタ", "Search Filter")}</h4>
            <p class="detail-text" style="margin:12px auto 0;max-width:760px;text-align:center;">{t("上が全体リニューアル前、下がリニューアル後です。中央のタイトルを左揃えの大見出しに変え、戻る・ヘルプのボタンをガラスの丸ボタンに。カードにはやわらかい影をつけ、項目のまとまりがわかりやすくなるようにしました。", "Top row: before the full redesign. Bottom row: after. The centered title became a large left-aligned heading, the back and help buttons became round glass buttons, and cards got a soft shadow so each group stands out.")}</p>
            <div class="lg-sf-label lg-label lg-label--before">BEFORE</div>
            <div class="lg-sf-row">
              {sfScreens.map((s) => (
                <img src={`/images/lg-sfb-${s.id}.webp`} loading="lazy" alt={`${s.label} — BEFORE`} />
              ))}
            </div>
            <div class="lg-sf-label lg-label lg-label--after">AFTER</div>
            <div class="lg-sf-row">
              {sfScreens.map((s) => (
                <img src={`/images/lg-sfa-${s.id}.webp`} loading="lazy" alt={`${s.label} — AFTER`} />
              ))}
            </div>
          </div>

          <!-- KEY CHANGES -->
          <div class="lg-points">
            <h4 class="disp detail-heading" style="text-align:center;">{t("主な変更点", "Key Changes")}</h4>
            <ol>
              {points.map(([title, body]) => (
                <li>
                  <h5 class="disp">{title}</h5>
                  <p class="detail-text">{body}</p>
                </li>
              ))}
            </ol>
          </div>

          <!-- LIGHT / DARK -->
          <div class="lg-block">
            <h4 class="disp detail-heading" style="text-align:center;">LIGHT / DARK</h4>
            <div class="lg-phones lg-phones--3">
              <img src="/images/lg-home-light.webp" loading="lazy" alt={t("ホーム（ライトモード）", "Home (light mode)")} />
              <img src="/images/lg-home-dark.webp" loading="lazy" alt={t("ホーム（ダークモード）", "Home (dark mode)")} />
              <img src="/images/lg-map-dark.webp" loading="lazy" alt={t("マップ（ダークモード）", "Map (dark mode)")} />
            </div>
            <a href="/images/lg-colors.webp" target="_blank" rel="noopener" class="lightbox-trigger lg-wide" style="display:block;">
              <img src="/images/lg-colors.webp" loading="lazy" width="1470" height="1352" alt={t("ライト／ダークのカラーパレット", "Light / dark color palette")} />
            </a>
          </div>

          <!-- CHARGING -->
          <div class="lg-block">
            <h4 class="disp detail-heading" style="text-align:center;">{t("充電の流れ", "Charging Flow")}</h4>
            <p class="detail-text" style="margin:12px auto 0;max-width:760px;text-align:center;">{t("充電の確認 → 充電中 → 充電完了。ロック画面とダイナミックアイランドにも同じイラストと経過時間を表示します。", "Confirm → charging → complete. The Lock Screen and Dynamic Island show the same illustration and elapsed time.")}</p>
            <div class="lg-phones lg-phones--3">
              <img src="/images/lg-confirm.webp" loading="lazy" alt={t("充電の確認", "Confirm charging")} />
              <img src="/images/lg-charging.webp" loading="lazy" alt={t("充電中", "Charging")} />
              <img src="/images/lg-complete.webp" loading="lazy" alt={t("充電完了", "Charging complete")} />
            </div>
            <div class="lg-phones lg-phones--2">
              <img src="/images/lg-island-lock.webp" loading="lazy" alt={t("ロック画面の充電通知", "Charging notification on the Lock Screen")} />
              <img src="/images/lg-island-ext.webp" loading="lazy" alt={t("ダイナミックアイランド（充電中）", "Dynamic Island while charging")} />
            </div>
          </div>

          <!-- COMPONENTS -->
          <div class="case-showcase-2col">
            <div>
              <img src="/images/lg-coupon.webp" class="lg-single" loading="lazy" alt={t("クーポン一覧", "Coupon list")} />
              <p class="detail-text" style="margin-top:16px;">{t("クーポンはチケットの形に。選択中・並び替え・削除などの状態がひと目でわかるようにしました。", "Coupons became ticket shapes, so states like selected, reordering and deleting are clear at a glance.")}</p>
            </div>
            <div>
              <img src="/images/lg-buttons.webp" class="lg-single" loading="lazy" alt={t("ボタンのバリエーション", "Button variations")} />
              <p class="detail-text" style="margin-top:16px;">{t("ボタンはサイズと役割ごとにバリエーションを整理し、デザインシステムのコンポーネントとして定義しました。", "Buttons were organized by size and role and defined as design system components.")}</p>
            </div>
          </div>

          <div class="case-cta" style="text-align:center;margin-top:4px;">
            <a href="#contact" class="btn">Contact Me</a>
          </div>
        </div>
      </div>
    </section>

    <Contact lang={lang} />
  </div>
</Layout>

<style>
  .lg-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: #c60d31;
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .lg-wide {
    max-width: 760px;
    margin: 72px auto 0;
  }
  .lg-wide img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
  }
  .lg-ba,
  .lg-points,
  .lg-block {
    margin: 72px auto 0;
    max-width: 960px;
  }
  .lg-ba-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 32px;
    align-items: center;
    margin-top: 40px;
  }
  .lg-ba-row figure {
    margin: 0;
  }
  /* screens have transparent corners, so the shadow follows the phone shape */
  .lg-ba-row img,
  .lg-phones img,
  .lg-single {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 16px 24px rgba(16, 27, 52, 0.16));
  }
  .lg-ba-row img {
    aspect-ratio: 360 / 800;
    object-fit: cover;
    object-position: top;
    border-radius: 0 0 24px 24px;
  }
  .lg-ba-note h5,
  .lg-points h5 {
    font-size: 16px;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .lg-label {
    margin-top: 12px;
    text-align: center;
    font-family: "Sora", sans-serif;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.14em;
  }
  .lg-label--before {
    color: #8a93a3;
  }
  .lg-label--after {
    color: #c60d31;
  }
  .lg-points ol {
    list-style: none;
    counter-reset: pt;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .lg-points li {
    counter-increment: pt;
    background: #fff;
    border-radius: 14px;
    padding: 24px 24px 24px 64px;
    position: relative;
  }
  .lg-points li::before {
    content: counter(pt, decimal-leading-zero);
    position: absolute;
    left: 22px;
    top: 22px;
    font-family: "Sora", sans-serif;
    font-weight: 800;
    font-size: 15px;
    color: #c60d31;
  }
  .lg-phones {
    display: grid;
    gap: 32px;
    margin: 32px auto 0;
    align-items: start;
  }
  .lg-phones--3 {
    grid-template-columns: repeat(3, 1fr);
    max-width: 860px;
  }
  .lg-phones--2 {
    grid-template-columns: repeat(2, 1fr);
    max-width: 560px;
    margin-top: 48px;
  }
  .lg-sf-label {
    margin-top: 36px;
  }
  .lg-sf-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 16px;
    align-items: start;
  }
  .lg-sf-row img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 12px 20px rgba(16, 27, 52, 0.14));
  }
  .lg-single {
    max-width: 320px;
    margin: 0 auto;
  }
  @media (max-width: 760px) {
    .lg-ba-row {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .lg-ba-note {
      grid-column: 1 / -1;
    }
    .lg-points ol {
      grid-template-columns: 1fr;
    }
    .lg-phones {
      gap: 12px;
    }
    .lg-sf-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  @media (max-width: 600px) {
