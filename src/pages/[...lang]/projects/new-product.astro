---
import Layout from "../../../layouts/Layout.astro";
import Contact from "../../../components/Contact.astro";
import ProjectNav from "../../../components/ProjectNav.astro";
import ToolStickers from "../../../components/ToolStickers.astro";
import { otherProjects, localize } from "../../../data/otherProjects.js";
import { langParams, getLang, useT, localePath } from "../../../i18n.js";

export function getStaticPaths() {
  return langParams.map((params) => ({ params }));
}

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const project = localize(otherProjects.find((p) => p.slug === "new-product"), lang);

---

<Layout lang={lang} title={`${project.label} — Kai Usui Portfolio`} description={project.concept}>
  <div style="min-height:100vh;position:relative;background:#eef4fb;">
    <ProjectNav lang={lang} />

    <section class="section" style="padding-top:80px;padding-bottom:50px;position:relative;">
      <ToolStickers tools={"Photoshop Adobe XD After Effects"} />
      <div
        class="ghost"
        style="position:absolute;top:20px;left:50%;transform:translateX(-50%);font-size:clamp(60px,10vw,150px);z-index:0;opacity:.7;white-space:nowrap;"
      >
        MY WORKS
      </div>
      <div class="wrap" style="position:relative;z-index:1;">
        <div style="text-align:center;">
          <div class="eyebrow" style="justify-content:center;">Portfolio</div>
          <h1 class="disp" style="font-size:clamp(34px,4.6vw,52px);font-weight:800;color:var(--ink);">CASE {project.caseNumber}</h1>
          <a href={localePath(lang, "/") + "#other"} style="font-size:13.5px;color:var(--accent-2);display:inline-block;margin-top:10px;">← Back to home</a>
        </div>

        <div style="margin-top:56px;">
          <div class="case-media-grid">
            <a
              href="/images/case1-full.jpg"
              target="_blank"
              rel="noopener"
              class="shot-panel lightbox-trigger"
              style="display:flex;align-items:center;justify-content:center;"
            >
              <img src="/images/case1-top.jpg" style="width:100%;object-fit:contain;border-radius:10px;" alt={t("AI検出サービス LP", "AI detection service LP")} />
              <span class="expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            <div>
              <div class="case-num">CASE {project.caseNumber}</div>
              <h2 class="disp case-title-lg">{t("大手企業の新商品特化ページ", "New Product Page for a Major Company")}</h2>
              <hr class="divider" style="margin:24px 0;max-width:120px;" />
              <div class="meta-label">{t("期間", "Duration")}</div>
              <p class="meta-value">{t("約2ヶ月", "About 2 months")}</p>
              <div class="meta-label">{t("チーム構成", "Team")}</div>
              <p class="meta-value">{t("デザイナー1（自身）", "1 designer (me)")}<br />{t("コーダー1", "1 front-end developer")}<br />{t("ディレクター1", "1 director")}</p>
              <p style="font-size:11.5px;color:var(--ink-faint);margin-top:10px;">{t("※守秘義務により、テキスト・画像・ロゴはすべてダミーのものを使用しています。", "* To comply with confidentiality agreements, all texts, images and logos shown are placeholders.")}</p>
            </div>
          </div>

          <div class="ghost-mid">DETAILS</div>

          <div class="grid-3 detail-grid">
            <div>
              <h4 class="disp detail-heading">{t("背景・課題", "Background & Challenge")}</h4>
              <p class="detail-text">{t("クライアントの新商品リリースにあたり、その製品に特化したランディングページ（LP）を新規制作しました。製品は第4世代となる進化型モデルであり、新たに搭載された「AI機能」を強みとして、新規顧客への魅力訴求・獲得と、既存ユーザーへのバージョンアップ促進というニーズに応える構成が求められました。", "For a client’s new product release, I created a new landing page (LP) dedicated to that product. The product was an evolved fourth-generation model, and the page needed to use its newly added “AI features” as a selling point — appealing to and winning new customers while encouraging existing users to upgrade.")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("目的・KPI", "Goals & KPIs")}</h4>
              <ul class="detail-list">
                <li>{t("カタログダウンロード数の増加", "Increase catalog downloads")}</li>
                <li>{t("お問い合わせ件数の向上", "Increase inquiries")}</li>
                <li>{t("製品の進化・AI機能を明確に伝えること", "Clearly communicate the product’s evolution and AI features")}</li>
              </ul>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("担当範囲", "My Role")}</h4>
              <ul class="detail-list">
                <li>{t("情報設計（構成・導線）", "Information architecture (structure and user flow)")}</li>
                <li>{t("UIデザイン（デザインカンプ）", "UI design (design comps)")}</li>
                <li>{t("ファーストビュー動画演出", "Hero video direction")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("アプローチ・工夫点", "Approach")}</h4>
              <p class="detail-text"><b style="color:var(--ink);">{t("1. 情報設計：論理 × 行動導線", "1. Information architecture: logic × user flow")}</b><br />{t("ファーストビューに背景動画＋メッセージで製品の進化を視覚的に印象付け、特徴や利点を段階的に紹介。CTA（ダウンロード・問い合わせ）を適切な間隔で挿入し、スムーズな行動導線を構築しました。", "A background video and message in the hero section make the product’s evolution visually memorable, followed by a step-by-step introduction of its features and benefits. CTAs (download and inquiry) are placed at regular intervals to create a smooth path to action.")}</p>
              <p class="detail-text" style="margin-top:14px;"><b style="color:var(--ink);">{t("2. ビジュアルデザインの工夫", "2. Visual design")}</b><br />{t("自動再生動画により「プロフェッショナルな印象」と「技術力の高さ」を強調。前作LPとの差別化を意識し、明るめの配色とAI感のあるグラデーションで未来感と視認性を両立しました（前バージョンの緑系から、青に近い色へ変更）。", "An autoplay video emphasizes a professional impression and technical excellence. To set it apart from the previous LP, a brighter palette and AI-inspired gradients balance a futuristic feel with readability (shifting from the previous version’s greens to colors closer to blue).")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("キーワード", "Keywords")}</h4>
              <ul class="detail-list">
                <li>{t("明るい", "Bright")}</li>
                <li>{t("AI・賢い", "AI & smart")}</li>
                <li>{t("クール", "Cool")}</li>
              </ul>
            </div>
            <div>
              <h4 class="disp detail-heading">{t("メインカラー", "Main Colors")}</h4>
              <div class="swatch-row">
                <div class="swatch"><span style="background:#EAF3FF;border:1px solid var(--border);"></span>#EAF3FF</div>
                <div class="swatch"><span style="background:#1B3B6F;"></span>#1B3B6F</div>
                <div class="swatch"><span style="background:#4C8DFF;"></span>#4C8DFF</div>
              </div>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("使用ツール・技術", "Tools & Skills")}</h4>
              <p class="detail-text">{t("Photoshop（図版作成・画像処理）", "Photoshop (graphics and image editing)")}<br />{t("Adobe XD（UIデザインカンプ）", "Adobe XD (UI design comps)")}<br />{t("After Effects（FVの動画演出）", "After Effects (hero video)")}</p>
              <h4 class="disp detail-heading" style="margin-top:32px;">{t("成果", "Results")}</h4>
              <p class="detail-text">{t("リリース後、クライアント社内・エンドユーザー双方からデザイン性・訴求力ともに高い評価。カタログDL数・問い合わせ件数も増加しました。", "After launch, the design and its persuasiveness were highly praised by both the client’s team and end users. Catalog downloads and inquiries also increased.")}</p>
            </div>
          </div>

          <div class="case-showcase-2col">
            <div>
              <video
                class="imgbox"
                style="aspect-ratio:656/430;object-fit:cover;"
                src="/images/case1-visual2.mp4"
                autoplay
                loop
                muted
                playsinline
                aria-label={t("メインビジュアルの背景演出", "Main visual background animation")}
              ></video>
              <p class="detail-text" style="margin-top:16px;">{t("メインビジュアルでは、AI搭載という特長を強調するため、テクノロジー感のあるパーティクル・ウェーブの背景を用いて、直感的に先進性を伝える演出を加えました。", "To highlight the built-in AI, the main visual uses a high-tech particle-wave background that conveys innovation intuitively.")}</p>
            </div>
            <div>
              <img src="/images/case1-detail02.png" class="imgbox" alt={t("機能紹介セクションの画面", "Feature section screen")} />
              <p class="detail-text" style="margin-top:16px;">{t("このセクションでは、従来製品との進化点を直感的に伝えるため、現場での測定シーンを想起させるような動きで紹介しています。", "To show intuitively how the product has evolved from previous models, this section uses motion that evokes measurement scenes in the field.")}</p>
            </div>
          </div>

          <div class="case-mockup">
            <img src="/images/case1-thedesign.png" class="no-shadow" alt={t("THE DESIGN — AI検出サービス LP デザイン", "THE DESIGN — AI detection service LP")} />
          </div>

          <div class="case-cta" style="text-align:center;margin-top:4px;">
            <a href="#contact" class="btn">Contact Me</a>
          </div>
        </div>
      </div>
    </section>

    <Contact lang={lang} />
  </div>
</Layout>
