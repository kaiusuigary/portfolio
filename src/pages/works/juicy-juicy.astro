---
// Juicy Juicy (CASE 16) — self-hosted rebuild of juicy-juicy-drink.webflow.io.
// Standalone page: does not use the portfolio layout.
const base = "/works/juicy-juicy";
const slides = [
  { name: "Organic Apple & Guava Juice", img: "bottle1", word: "word1" },
  { name: "Organic Lean and Green Juice", img: "bottle2", word: "word2" },
  { name: "Organic Banana, Mango & Apple Juice", img: "bottle3", word: "word3", wordTall: true },
  { name: "Organic Great Apple Juice", img: "bottle4", word: "word4" },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Juicy Juicy</title>
  <meta name="description" content="Choose Your Favour" />
  <meta property="og:title" content="Juicy-Juicy" />
  <meta property="og:description" content="Choose Your Favour" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={`https://kaiusuiportfolio.com${base}/og.png`} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a href="#" class="brand" aria-label="Juicy Juicy"><img src={`${base}/logo.png`} alt="Juicy Juicy" width="276" height="122" /></a>
      <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="nav-menu" class="nav-menu">
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
      </nav>
    </div>
  </header>

  <main class="hero">
    <div class="slider" aria-roledescription="carousel" aria-label="Products">
      <div class="viewport">
        <div class="track">
          {slides.map((s, i) => (
            <section
              class:list={["slide", { "is-active": i === 0 }]}
              aria-roledescription="slide"
              aria-label={`${i + 1} / ${slides.length}`}
              aria-hidden={i === 0 ? undefined : "true"}
              inert={i === 0 ? undefined : true}
            >
              <div class="slide-inner">
                <img class:list={["word", { tall: s.wordTall }]} src={`${base}/${s.word}.png`} alt="" aria-hidden="true" />
                <div class="info">
                  <h1 class="title">{s.name} – 12 x 360ml</h1>
                  <p class="note">This is a dummy site.</p>
                  <p class="price">$49.99</p>
                  <p class="payment">or 4 interest-free payments of $12.50 with YESpay*</p>
                  <p class="desc">Feeling a little adventurous? This one is for you! A one of a kind apple guava blend that will make your taste buds sing.</p>
                  <form class="cart" onsubmit="return false">
                    <label for={`qty-${i}`}>Quantity</label>
                    <input id={`qty-${i}`} type="number" min="1" value="1" inputmode="numeric" />
                    <button type="submit" class="cart-btn">ADD TO CART</button>
                  </form>
                </div>
                <div class="media">
                  <img
                    src={`${base}/${s.img}.png`}
                    srcset={`${base}/${s.img}-500.png 500w, ${base}/${s.img}-800.png 800w, ${base}/${s.img}.png 820w`}
                    sizes="(max-width: 991px) min(78vw, 340px), min(30vw, 480px)"
                    width="820" height="1020"
                    alt={`${s.name} bottle`}
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>
      <button class="arrow prev" type="button" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
      </button>
      <button class="arrow next" type="button" aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg>
      </button>
      <div class="dots">
        {slides.map((s, i) => (
          <button type="button" class:list={["dot", { "is-active": i === 0 }]} aria-label={`Show slide ${i + 1}: ${s.name}`} aria-current={i === 0 ? "true" : undefined}></button>
        ))}
      </div>
    </div>
  </main>

  <footer class="footer">
    <img src={`${base}/logo.png`} alt="Juicy Juicy" width="276" height="122" />
    <p>Copyright 2050, Juicy Juicy. All right reserves.</p>
  </footer>

  <script>
    const slider = document.querySelector(".slider");
    const track = slider.querySelector(".track");
    const slides = [...slider.querySelectorAll(".slide")];
    const dots = [...slider.querySelectorAll(".dot")];
    let index = 0;

    function go(next) {
      index = (next + slides.length) % slides.length;
      track.style.transform = `translateX(${-index * 100}%)`;
      slides.forEach((s, i) => {
        const on = i === index;
        s.classList.toggle("is-active", on);
        s.inert = !on;
        on ? s.removeAttribute("aria-hidden") : s.setAttribute("aria-hidden", "true");
      });
      dots.forEach((d, i) => {
        d.classList.toggle("is-active", i === index);
        i === index ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current");
      });
    }

    slider.querySelector(".prev").addEventListener("click", () => go(index - 1));
    slider.querySelector(".next").addEventListener("click", () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
    document.addEventListener("keydown", (e) => {
      if (e.target.closest("input")) return;
      if (e.key === "ArrowLeft") go(index - 1);
      if (e.key === "ArrowRight") go(index + 1);
    });

    // Horizontal swipe (touch / pen). Vertical scrolling stays native.
    let startX = 0, startY = 0, tracking = false;
    const viewport = slider.querySelector(".viewport");
    viewport.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" || e.target.closest("input, button")) return;
      tracking = true; startX = e.clientX; startY = e.clientY;
    });
    viewport.addEventListener("pointerup", (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX, dy = e.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
    });
    viewport.addEventListener("pointercancel", () => (tracking = false));

    // Mobile menu
    const btn = document.querySelector(".menu-btn");
    const menu = document.getElementById("nav-menu");
    const setMenu = (open) => {
      btn.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("is-open", open);
    };
    btn.addEventListener("click", () => setMenu(btn.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => e.target.closest("a") && setMenu(false));
  </script>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; overflow-x: clip; }
    body {
      background: #fefefe;
      color: #333;
      font-family: Roboto, sans-serif;
      font-size: 14px;
      line-height: 1.43;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
    }
    img { display: block; max-width: 100%; height: auto; }
    p { margin: 0; }
    button { font: inherit; }

    /* ---------- Header ---------- */
    .nav { position: relative; z-index: 10; padding: 8px 20px; }
    .nav-inner {
      margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
    }
    .brand img { width: 120px; }
    .nav-menu { display: flex; }
    .nav-menu a {
      font-family: Barlow, sans-serif; font-weight: 700; font-size: 15px;
      color: #222; text-decoration: none; padding: 20px;
    }
    .nav-menu a:hover { color: #0082f3; }
    .menu-btn {
      display: none; width: 44px; height: 44px; padding: 12px;
      border: 0; background: #fff; cursor: pointer;
      flex-direction: column; justify-content: space-between;
    }
    .menu-btn span { display: block; height: 2px; background: #222; border-radius: 1px; }

    /* ---------- Slider ---------- */
    .hero { flex: 1; display: flex; align-items: center; padding: 16px 0 24px; }
    /* Slide = 1280px wide; neighbours stay visible (blurred) outside it on wide screens */
    .slider { position: relative; width: 100%; max-width: 1280px; margin: 0 auto; }
    .viewport { touch-action: pan-y; }
    .track { display: flex; transition: transform .6s cubic-bezier(.25, .46, .45, .94); }
    .slide { flex: 0 0 100%; min-width: 0; }
    .slide-inner {
      position: relative; isolation: isolate;
      margin: 0 auto;
      padding: 0 100px; /* keeps text clear of the arrows */
      display: grid; grid-template-columns: minmax(0, 1fr) auto;
      align-items: center; column-gap: 40px;
    }

    .info { position: relative; max-width: 620px; }
    .word {
      position: absolute; z-index: -1; pointer-events: none;
      left: 100px; bottom: 0; width: 72%;
    }
    .word.tall { width: auto; height: 100%; }
    .title {
      margin: 0; font-weight: 300; text-transform: uppercase; line-height: 1.3;
      font-size: clamp(32px, 3.5vw, 56px); text-wrap: balance;
    }
    .note { color: #888; font-size: 10px; margin-top: 16px; }
    .price { font-size: 40px; font-weight: 700; margin-top: 20px; line-height: 1.2; }
    .payment, .desc { font-size: 17px; text-transform: uppercase; line-height: 1.2; margin-top: 16px; }
    .payment { font-weight: 700; }
    .desc { color: #777; }

    .cart { display: flex; flex-direction: column; align-items: flex-start; margin-top: 40px; }
    .cart label { font-size: 22px; font-weight: 500; margin-bottom: 5px; }
    .cart input {
      width: 356px; max-width: 100%; height: 38px; padding: 8px 12px;
      font: inherit; color: #333; border: 1px solid #ccc; background: #fff;
      margin-bottom: 24px;
    }
    .cart input:focus { outline: none; border-color: #3898ec; }
    .cart-btn {
      width: 356px; max-width: 100%; padding: 16px 0; border: 0; border-radius: 8px; cursor: pointer;
      color: #fff; font-size: 16px; font-weight: 700;
      background: linear-gradient(315deg, #00c9bc, #1e8bae);
      box-shadow: 0 3px 20px 2px #1e8bae59;
      transition: transform .2s, box-shadow .2s;
    }
    .cart-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 24px 2px #1e8bae66; }

    .media img {
      width: min(30vw, 480px);
      filter: blur(7px); transform: scale(.94); opacity: .85;
      transition: filter .8s ease, transform .8s ease, opacity .8s ease;
    }
    .slide.is-active .media img { filter: none; transform: none; opacity: 1; }
    .info, .word { transition: opacity .6s ease .15s; }
    .slide:not(.is-active) .info { opacity: 0; }

    .arrow {
      position: absolute; top: 50%; translate: 0 -50%; z-index: 3;
      width: 70px; height: 70px; border: 0; border-radius: 50%; cursor: pointer;
      display: grid; place-items: center;
      background: #0000001a; -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
      transition: background .2s;
    }
    .arrow:hover { background: #00000033; }
    .arrow svg { width: 32px; height: 32px; fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
    .prev { left: 10px; }
    .next { right: 10px; }

    .dots { display: flex; justify-content: center; gap: 4px; margin-top: 32px; }
    .dot {
      width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer;
      display: grid; place-items: center;
    }
    .dot::before { content: ""; width: 12px; height: 12px; border-radius: 50%; background: #0006; transition: background .2s; }
    .dot.is-active::before { background: #222; }

    /* ---------- Footer ---------- */
    .footer {
      display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
      gap: 12px 24px; padding: 16px 20px 24px; text-align: center;
    }
    .footer img { width: 90px; }

    /* ---------- Tablet & mobile ---------- */
    @media (max-width: 991px) {
      .menu-btn { display: flex; }
      .menu-btn[aria-expanded="true"] { background: #f2f2f2; }
      .nav-menu {
        display: none; position: absolute; top: 100%; left: 0; right: 0;
        flex-direction: column; background: #fff; box-shadow: 0 8px 16px #0000000f;
      }
      .nav-menu.is-open { display: flex; }
      .nav-menu a { padding: 16px 20px; }

      .hero { align-items: flex-start; }
      .slide-inner {
        grid-template-columns: minmax(0, 1fr);
        justify-items: center; text-align: center;
        padding: 0 20px; row-gap: 24px;
      }
      .media { order: -1; }
      .media img { width: var(--media-w); }
      .info { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 560px; }
      .word { left: 50%; bottom: auto; top: calc(var(--media-w) * 1.244 - 16px); translate: -50% 0; width: min(100%, 640px); }
      .word.tall { width: min(70%, 420px); height: auto; }
      .title { font-size: clamp(24px, 5vw, 40px); }
      .cart { align-items: center; width: 100%; margin-top: 32px; }
      .cart input, .cart-btn { width: 100%; max-width: 420px; }

      /* Arrows sit at the side of the bottle image, never over the text */
      .arrow { top: calc(var(--media-w) * 1.244 / 2); width: 56px; height: 56px; }
      .arrow svg { width: 26px; height: 26px; }
      .prev { left: max(12px, calc(50% - var(--media-w) / 2 - 72px)); }
      .next { right: max(12px, calc(50% - var(--media-w) / 2 - 72px)); }
      .slider { --media-w: min(78vw, 340px); }
    }

    @media (max-width: 479px) {
      .slider { --media-w: min(68vw, 280px); }
      .brand img { width: 100px; }
      .arrow { width: 44px; height: 44px; }
      .arrow svg { width: 22px; height: 22px; }
      .prev { left: 8px; }
      .next { right: 8px; }
      .price { font-size: 28px; margin-top: 12px; }
      .payment, .desc { font-size: 15px; }
      .cart label { font-size: 18px; }
      .footer p { font-size: 12px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .track, .media img, .info, .word { transition: none !important; }
    }
  </style>
</body>
</html>
